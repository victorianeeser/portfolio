---
// The home page header, in black and white:
// - the name's letters rise in one by one, and each hops on hover
// - "I design ___" cycles through what the projects are, each word drawing its underline in
// With reduced motion everything holds still and the sentence reads in full.
import { site } from '../site.config';

// What I design, from the projects below
const words = ['smart products', 'apps', 'brands', 'games', 'experiences'];

const letters = [...site.name];
const sentence = `I design ${words.slice(0, -1).join(', ')} and ${words.at(-1)}.`;
---

<section class="hhero" aria-labelledby="hero-title">
  <div class="hhero__inner container">
    <p class="eyebrow hhero__hello">Hi, I’m</p>
    <h1 id="hero-title" class="hhero__name" aria-label={site.name}>
      {
        letters.map((ch, i) =>
          ch === ' ' ? (
            <span class="hhero__space" aria-hidden="true"> </span>
          ) : (
            <span class="hhero__letter" aria-hidden="true" style={`--i: ${i}`}>
              {ch}
            </span>
          ),
        )
      }
    </h1>

    <p class="hhero__line">
      <span class="visually-hidden">{sentence}</span>
      <span aria-hidden="true">I design </span>
      <span class="hhero__words" aria-hidden="true">
        {words.map((text, i) => <span class="hhero__word" data-active={i === 0 ? '' : undefined}>{text}</span>)}
      </span>
    </p>

    <p class="hhero__statement lead">{site.positioning}</p>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('.hhero');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  if (hero && !reduce.matches) {
    // Cycle the words: the current one slides up and out, the next slides in from below
    const words = [...hero.querySelectorAll<HTMLElement>('.hhero__word')];
    let i = 0;
    setInterval(() => {
      if (document.hidden) return;
      const current = words[i];
      i = (i + 1) % words.length;
      current.removeAttribute('data-active');
      current.setAttribute('data-leaving', '');
      setTimeout(() => current.removeAttribute('data-leaving'), 600);
      words[i].setAttribute('data-active', '');
    }, 2200);
  }
</script>

<style>
  .hhero {
    padding-block: var(--space-9) var(--space-8);
  }

  .hhero__inner {
    position: relative;
  }

  /* ---------- Name ---------- */
  .hhero__hello {
    color: var(--color-text-secondary);
    animation: hhero-fade 0.8s var(--ease-out) both;
  }

  .hhero__name {
    margin-top: var(--space-3);
    font-size: clamp(3rem, 9vw, 7.5rem);
    font-weight: var(--weight-medium);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--color-text);
  }

  .hhero__letter,
  .hhero__space {
    display: inline-block;
  }

  .hhero__space {
    width: 0.25em;
  }

  /* Each letter rises in, one after another */
  .hhero__letter {
    animation: hhero-rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(0.15s + var(--i) * 0.045s);
    transition: transform 0.35s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  /* …and hops on hover */
  .hhero__letter:hover {
    transform: translateY(-0.12em) rotate(-4deg);
  }

  @keyframes hhero-rise {
    from {
      opacity: 0;
      transform: translateY(0.6em) rotate(6deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hhero-fade {
    from { opacity: 0; transform: translateY(0.5rem); }
    to { opacity: 1; transform: none; }
  }

  /* ---------- I design ___ ---------- */
  .hhero__line {
    margin-top: var(--space-5);
    font-size: clamp(1.5rem, 3.4vw, 2.5rem);
    font-weight: var(--weight-medium);
    line-height: 1.2;
    color: var(--color-text);
    animation: hhero-fade 0.8s var(--ease-out) 0.9s both;
  }

  /* All the words share one spot; only the active one shows */
  .hhero__words {
    display: inline-grid;
    vertical-align: bottom;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  /* justify-self: start keeps each word (and its underline) only as wide as its text */
  .hhero__word {
    position: relative;
    grid-area: 1 / 1;
    justify-self: start;
    color: var(--color-text);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(100%);
    transition:
      transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.4s ease;
  }

  .hhero__word[data-active] {
    opacity: 1;
    transform: none;
  }

  /* A thin underline draws in under each new word */
  .hhero__word::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.02em;
    height: 0.06em;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.35s;
  }

  .hhero__word[data-active]::after {
    transform: scaleX(1);
  }

  .hhero__word[data-leaving] {
    opacity: 0;
    transform: translateY(-100%);
  }

  .hhero__statement {
    max-width: var(--container-statement);
    margin-top: var(--space-6);
    text-wrap: balance;
    animation: hhero-fade 0.8s var(--ease-out) 1.1s both;
  }

  /* ---------- Reduced motion: hold still, read in full ---------- */
  @media (prefers-reduced-motion: reduce) {
    .hhero__letter,
    .hhero__hello,
    .hhero__line,
    .hhero__statement {
      animation: none;
      transition: none;
    }

    .hhero__letter:hover {
      transform: none;
    }

    /* The words show as one list instead of cycling */
    .hhero__words {
      display: inline;
    }

    .hhero__word {
      opacity: 1;
      transform: none;
    }

    .hhero__word::after {
      display: none;
    }

    .hhero__word:not(:last-child)::after {
      content: ',';
      color: var(--color-text);
    }

    .hhero__word:last-child::before {
      content: 'and ';
      color: var(--color-text);
    }

    .hhero__word + .hhero__word {
      margin-left: 0.3em;
    }
  }
</style>
