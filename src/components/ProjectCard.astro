---
import type { CollectionEntry } from 'astro:content';
import ImageSlot from './ImageSlot.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel: Heading = 'h3' } = Astro.props;
const { title, role, tags, cover, theme, comingSoon } = project.data;

// Each project's brand color for the title and tags on hover
const hoverColors: Record<string, string> = {
  impact: '#00e786',
  courtsync: '#015aff',
  wellness: '#1f5fae',
  'farm-friends': '#c0283f',
  rebound: '#4d37a4',
  oura: '#2f4a73',
};
const hover = theme ? hoverColors[theme] : undefined;
---

<article class:list={['card', comingSoon && 'card--soon']} style={hover ? `--card-hover: ${hover}` : undefined}>
  <ImageSlot {...cover} ratio="thumb" />
  <div class="card__body">
    <Heading class="card__title">
      {comingSoon ? title : <a href={`/work/${project.id}/`} class="card__link">{title}</a>}
      {comingSoon && <span class="card__soon">Coming soon</span>}
    </Heading>
    <p class="meta">{role}</p>
    <ul class="tag-list" aria-label="Tags">
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
  </div>
</article>

<style>
  /* The whole card is clickable via the title link's stretched ::after */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .card__title {
    font-size: var(--text-h3);
  }

  .card__link {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover .card__link {
    color: var(--card-hover, var(--color-hover));
  }

  /* On hover the cover takes a light wash of the project's color.
     To use a plain darken instead, set --card-tint to black. */
  .card {
    --card-tint: var(--card-hover, var(--color-text));
  }

  .card :global(.slot) {
    position: relative;
  }

  .card :global(.slot)::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
    background: var(--card-tint);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
    pointer-events: none;
  }

  .card:hover :global(.slot)::after {
    opacity: var(--card-tint-opacity);
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card__link:focus-visible::after {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-md);
  }

  .tag-list {
    margin-top: var(--space-2);
  }

  /* Coming soon: no link yet, but the same hover color and cover wash as the other cards */
  .card--soon .card__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .card__soon {
    padding: 0.15em 0.6em;
    border: var(--border);
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    font-weight: var(--weight-regular);
    color: var(--color-text-secondary);
  }

  .card--soon .card__title {
    transition: color var(--duration-fast) var(--ease-out);
  }

  .card--soon:hover .card__title {
    color: var(--card-hover, var(--color-hover));
  }
</style>
