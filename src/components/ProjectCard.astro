---
import type { CollectionEntry } from 'astro:content';
import ImageSlot from './ImageSlot.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel: Heading = 'h3' } = Astro.props;
const { title, role, tags, cover, theme } = project.data;

// Each project's brand color for the title on hover
const hoverColors: Record<string, string> = {
  impact: '#00e786',
  courtsync: '#015aff',
  wellness: '#152a44',
};
const hover = theme ? hoverColors[theme] : undefined;
---

<article class="card" style={hover ? `--card-hover: ${hover}` : undefined}>
  <ImageSlot {...cover} ratio="thumb" />
  <div class="card__body">
    <Heading class="card__title">
      <a href={`/work/${project.id}/`} class="card__link">{title}</a>
    </Heading>
    <p class="meta">{role}</p>
    <ul class="tag-list" aria-label="Tags">
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
  </div>
</article>

<style>
  /* The whole card is clickable via the title link's stretched ::after */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .card__title {
    font-size: var(--text-h3);
  }

  .card__link {
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover .card__link {
    color: var(--card-hover, var(--color-hover));
  }

  .card :global(.slot) {
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .card:hover :global(.slot) {
    opacity: var(--hover-opacity);
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card__link:focus-visible::after {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-md);
  }

  .tag-list {
    margin-top: var(--space-2);
  }
</style>
