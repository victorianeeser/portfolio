---
// Usability testing, round 2, for a navy Panel, leading with the result: the targeted
// question's score before → after in large type beside how many testers finished every
// task, then one card per task pairing it with its follow-up question and score ring
// (the targeted question's card marked with a coral star). Rings are drawn from the
// percentages given, and the gain is worked out from before and after.
import OuraStar from './OuraStar.astro';

interface Result {
  task: string;
  question: string;
  percent: number;
  focus?: boolean;
}

interface Props {
  results: Result[];
  completed: { done: number; of: number; text: string };
  /** The question the refinement targeted, before and after */
  improvement: { question: string; before: number; after: number };
}

const { results, completed, improvement } = Astro.props;
const gain = improvement.after - improvement.before;

const R = 42;
const C = 2 * Math.PI * R;
---

<div class="round2 case-wide">
  <div class="round2__headline">
    <section class="round2__gain" aria-label={`${improvement.question} ${improvement.before}% in version 1, ${improvement.after}% in version 2`}>
      <p class="round2__eyebrow">
        <OuraStar size="0.9rem" />
        {improvement.question}
      </p>
      <div class="round2__numbers" aria-hidden="true">
        <span class="round2__before">
          <strong>{improvement.before}%</strong>
          <span>Version 1</span>
        </span>
        <span class="round2__arrow">→</span>
        <span class="round2__after">
          <strong>{improvement.after}%</strong>
          <span>Version 2</span>
        </span>
      </div>
      <p class="round2__delta">+{gain} points after the refinement</p>
    </section>

    <section class="round2__done">
      <p class="round2__big">
        {completed.done}<span>/{completed.of}</span>
      </p>
      <p class="round2__done-text">{completed.text}</p>
    </section>
  </div>

  <ol class="round2__results" role="list">
    {
      results.map(({ task, question, percent, focus }, i) => (
        <li class:list={[focus && 'is-focus']}>
          <p class="round2__num">
            {focus && <OuraStar size="0.85rem" />}
            Task {i + 1}
          </p>
          <p class="round2__task">{task}</p>
          <div class="round2__score">
            <figure class="round2__ring">
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <circle cx="50" cy="50" r={R} class="round2__track" />
                <circle cx="50" cy="50" r={R} class="round2__arc" stroke-dasharray={`${(C * percent) / 100} ${C}`} transform="rotate(-90 50 50)" />
              </svg>
              <figcaption>{percent}%</figcaption>
            </figure>
            <p class="round2__question">{question}</p>
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .round2 {
    margin-top: var(--space-6);
    color: #ffffff;
  }

  /* The result, in large type */
  .round2__headline {
    display: grid;
    gap: var(--space-4);
  }

  .round2__gain,
  .round2__done {
    padding: var(--space-6);
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.07);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }

  .round2__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: #d5deeb;
  }

  .round2__eyebrow :global(.oura-star) {
    flex: none;
    color: #ff8a80;
  }

  .round2__numbers {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .round2__before,
  .round2__after {
    display: grid;
    gap: var(--space-1);
  }

  .round2__numbers strong {
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: var(--weight-medium);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .round2__numbers span span {
    font-size: var(--text-small);
    color: #d5deeb;
  }

  .round2__before strong {
    color: #ff8a80;
  }

  .round2__after strong {
    color: #9fd0f7;
  }

  .round2__arrow {
    font-size: var(--text-h2);
    color: #d5deeb;
  }

  .round2__delta {
    width: fit-content;
    margin-top: var(--space-5);
    padding: 0.3em 0.9em;
    border-radius: var(--radius-pill);
    background: rgb(159 208 247 / 0.16);
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    color: #9fd0f7;
  }

  .round2__done {
    display: grid;
    align-content: center;
    gap: var(--space-2);
  }

  .round2__big {
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: var(--weight-medium);
    line-height: 1;
    color: #ffffff;
  }

  .round2__big span {
    color: #d5deeb;
  }

  .round2__done-text {
    color: #d5deeb;
  }

  /* One card per task */
  .round2__results {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .round2__results li {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }

  .round2__results li.is-focus {
    box-shadow: inset 0 0 0 2px #ff8a80;
  }

  .round2__num {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: #9fd0f7;
  }

  .round2__num :global(.oura-star) {
    color: #ff8a80;
  }

  .round2__task {
    font-weight: var(--weight-medium);
    line-height: 1.45;
  }

  .round2__score {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: center;
    padding-top: var(--space-3);
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .round2__ring {
    position: relative;
    width: 4rem;
    margin: 0;
  }

  .round2__ring svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .round2__track,
  .round2__arc {
    fill: none;
    stroke-width: 10;
  }

  .round2__track {
    stroke: rgb(255 255 255 / 0.15);
  }

  .round2__arc {
    stroke: #9fd0f7;
    stroke-linecap: round;
  }

  .round2__ring figcaption {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
  }

  .round2__question {
    font-size: var(--text-small);
    line-height: 1.45;
    color: #d5deeb;
  }

  @media (min-width: 48rem) {
    .round2__results {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .round2__headline {
      grid-template-columns: 1.6fr 1fr;
    }

    .round2__results {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
