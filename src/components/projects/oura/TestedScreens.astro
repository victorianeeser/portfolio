---
// The version testers used: a row of the app's screens, in task order, each captioned with
// the task it belongs to. Made for a navy Panel, where the dark screens get a thin pale
// outline so their edges read. Five across on wide screens; a sideways-scrolling row on phones.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Screen {
  src: ImageMetadata;
  alt: string;
  task: number;
  name: string;
}

interface Props {
  label: string;
  screens: Screen[];
}

const { label, screens } = Astro.props;
---

<figure class="tested">
  <figcaption class="tested__label">{label}</figcaption>
  <ul class="tested__row" role="list" tabindex="0" aria-label={`${label}, scrollable`}>
    {
      screens.map(({ src, alt, task, name }) => (
        <li>
          <Image src={src} alt={alt} width={src.width} />
          <p>
            <span class="tested__task">Task {task}</span>
            <span class="tested__name">{name}</span>
          </p>
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .tested {
    margin: var(--space-6) 0 var(--space-7);
  }

  .tested__label {
    margin-bottom: var(--space-4);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: #b9cdea;
  }

  .tested__row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 42%;
    gap: var(--space-4);
    margin: 0;
    padding: 0 0 var(--space-3);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    list-style: none;
  }

  .tested__row:focus-visible {
    outline-offset: var(--space-1);
  }

  .tested__row li {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    scroll-snap-align: start;
  }

  .tested__row :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.25rem;
    box-shadow:
      0 0 0 1px rgb(185 205 234 / 0.35),
      0 1rem 2rem rgb(0 0 0 / 0.3);
  }

  .tested__row p {
    display: grid;
    gap: 0.15rem;
    font-size: var(--text-small);
  }

  .tested__task {
    font-weight: var(--weight-bold);
    color: #b9cdea;
  }

  .tested__name {
    color: #ffffff;
  }

  @media (min-width: 48rem) {
    .tested__row {
      grid-auto-columns: minmax(0, 1fr);
      overflow: visible;
      padding: 0;
    }
  }
</style>
