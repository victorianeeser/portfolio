---
// The conclusion, for a navy Panel: the takeaways as three numbered cards led by the slides'
// star, then a "next step" strip for what I'd do with more time. Stacks on phones.
import OuraStar from './OuraStar.astro';

interface Props {
  lessons: { title: string; text: string }[];
  next: { label: string; text: string };
}

const { lessons, next } = Astro.props;
---

<div class="oconc case-wide">
  <ol class="oconc__lessons" role="list">
    {
      lessons.map(({ title, text }, i) => (
        <li>
          <p class="oconc__num">
            <OuraStar size="1rem" />
            {String(i + 1).padStart(2, '0')}
          </p>
          <h3>{title}</h3>
          <p class="oconc__text">{text}</p>
        </li>
      ))
    }
  </ol>

  <aside class="oconc__next">
    <p class="oconc__label">{next.label}</p>
    <p class="oconc__next-text">{next.text}</p>
  </aside>
</div>

<style>
  .oconc {
    margin-top: var(--space-6);
    color: #ffffff;
  }

  .oconc__lessons {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .oconc__lessons li {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-6);
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.07);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }

  .oconc__num {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    color: #9fd0f7;
  }

  .oconc__lessons h3 {
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    line-height: 1.3;
    color: #ffffff;
  }

  .oconc__text {
    color: #d5deeb;
    line-height: 1.55;
  }

  /* What comes next: a lighter strip under the takeaways */
  .oconc__next {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: var(--space-5) var(--space-6);
    border-radius: 1.25rem;
    background: #b9cdea;
    color: #1f3352;
  }

  .oconc__label {
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .oconc__next-text {
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    line-height: 1.4;
  }

  @media (min-width: 64rem) {
    .oconc__lessons {
      grid-template-columns: repeat(3, 1fr);
    }

    .oconc__next {
      grid-template-columns: 12rem 1fr;
      align-items: baseline;
      gap: var(--space-6);
    }
  }
</style>
