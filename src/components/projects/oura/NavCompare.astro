---
// Current vs. redesigned nav bar. The current bar is a screenshot from the app; the
// redesigned bar is rebuilt from the Figma nav component (icons, labels and the dimmed
// unselected tabs as designed), shown in the same black frame so the two compare directly.
import { Image } from 'astro:assets';
import current from '../../../assets/projects/oura/nav-current.jpg';
import today from '../../../assets/projects/oura/nav-today.svg?raw';
import readiness from '../../../assets/projects/oura/nav-readiness.svg?raw';
import sleep from '../../../assets/projects/oura/nav-sleep.svg?raw';
import activity from '../../../assets/projects/oura/nav-activity.svg?raw';
import myHealth from '../../../assets/projects/oura/nav-my-health.svg?raw';

// The exported icons keep their own colors; only the inline sizing from Figma is removed
const clean = (svg: string) => svg.replace(/ style="[^"]*"/, '').replace(/ preserveAspectRatio="none"/, '');

// state: how the tab looks in the design. Today is selected, Readiness is at 40%, the rest are grey.
const tabs = [
  { label: 'Today', icon: clean(today), state: 'on' },
  { label: 'Readiness', icon: clean(readiness), state: 'dim' },
  { label: 'Sleep', icon: clean(sleep), state: 'off' },
  { label: 'Activity', icon: clean(activity), state: 'off' },
  { label: 'My Health', icon: clean(myHealth), state: 'off' },
];
---

<div class="navs case-wide">
  <section class="navs__item">
    <h3 class="navs__title">Current nav bar</h3>
    <Image src={current} alt="The current Oura nav bar with three tabs: Today, Vitals and My Health" class="navs__shot" widths={[600, 1170]} sizes="(min-width: 48rem) 520px, 100vw" />
    <p>The current bar has <strong>Today (home page), Vitals and My Health.</strong> Vitals just repeats the information on the Today page.</p>
    <p>To see your stats, you go <strong>Vitals › tap Sleep › Sleep vitals open.</strong></p>
  </section>

  <section class="navs__item">
    <h3 class="navs__title">Redesigned nav bar</h3>
    <div
      class="navs__stage"
      role="img"
      aria-label="The redesigned nav bar with five tabs: Today, Readiness, Sleep, Activity and My Health"
    >
      <div class="navs__bar">
        {
          tabs.map(({ label, icon, state }) => (
            <span class="navs__tab" data-state={state}>
              <span class="navs__icon" set:html={icon} />
              {label}
            </span>
          ))
        }
      </div>
      <span class="navs__home" />
    </div>
    <p>The redesigned bar cuts the steps it takes to reach the three most important things: <strong>readiness, sleep and activity.</strong></p>
    <p><strong>You now see your stats in one step</strong>, by tapping the section you want.</p>
  </section>
</div>

<style>
  .navs {
    display: grid;
    gap: var(--space-7);
    margin-block: var(--space-7) var(--space-6);
    font-family: var(--case-font, var(--font-sans));
    color: var(--case-heading-1, var(--color-text));
  }

  /* Each bar is a white card on the cream background, matching the note cards above */
  .navs__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: var(--border-width) solid rgb(47 74 115 / 0.12);
    border-radius: 1rem;
    background: var(--color-bg);
    box-shadow: 0 0.25rem 1rem rgb(47 74 115 / 0.06);
  }

  .navs__title {
    margin-bottom: var(--space-2);
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: inherit;
  }

  /* Both bars sit in the same size of frame, so they compare side by side */
  .navs :global(.navs__shot),
  .navs__stage {
    width: 100%;
    aspect-ratio: 504 / 236;
  }

  .navs :global(.navs__shot) {
    height: auto;
    margin-bottom: var(--space-3);
    border-radius: 0.75rem;
    object-fit: cover;
    object-position: bottom;
  }

  /* The redesigned bar at the bottom of a black phone screen, like the current one */
  .navs__stage {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    margin-bottom: var(--space-3);
    padding-bottom: 3%;
    overflow: hidden;
    border-radius: 0.75rem;
    background: #000;
    container-type: inline-size;
  }

  .navs__bar {
    display: flex;
    padding: 0 2%;
  }

  .navs__tab {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: 1.6cqw;
    font-size: 3.2cqw;
    line-height: 1.2;
    color: #fff;
  }

  .navs__tab[data-state='dim'] {
    opacity: 0.4;
  }

  .navs__tab[data-state='off'] {
    color: #616161;
  }

  .navs__icon {
    display: grid;
    place-items: center;
    width: 7cqw;
    height: 7cqw;
  }

  .navs__icon :global(svg) {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* The phone's home indicator, as in the current-bar screenshot */
  .navs__home {
    align-self: center;
    width: 36%;
    height: 1.2cqw;
    margin-top: 5%;
    border-radius: var(--radius-pill);
    background: #fff;
  }

  .navs strong {
    color: inherit;
  }

  .navs p {
    font-size: var(--text-small);
    line-height: 1.5;
  }

  @media (min-width: 48rem) {
    .navs {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }
</style>
