---
// User flow, rebuilt from the Figma "User flow" slide as a tree of real elements: opening
// the app leads to four tabs, and each tab lists where it goes next. The three places Nova
// appears are highlighted in light blue and numbered, matching the slide.
// On phones the four tabs stack; on wide screens they sit side by side under the start node.
import OuraStar from './OuraStar.astro';

interface Node {
  label: string;
  /** Nova touchpoint number (1–3), shown highlighted */
  nova?: number;
  /** Further steps under this node */
  children?: Node[];
}

interface Props {
  start: string;
  branches: Node[];
  caption?: string;
}

const { start, branches, caption } = Astro.props;
---

<figure class="flow case-wide">
  {
    caption && (
      <figcaption class="flow__caption">
        <OuraStar size="1.25rem" />
        {caption}
      </figcaption>
    )
  }

  <div class="flow__tree">
    <p class="flow__node flow__node--start">{start}</p>

    <ul class="flow__branches" role="list">
      {
        branches.map(({ label, children = [] }) => (
          <li class="flow__branch">
            <p class="flow__node flow__node--tab">{label}</p>
            {children.length > 0 && (
              <ul class="flow__children" role="list">
                {children.map(({ label: l, nova, children: grand = [] }) => (
                  <li>
                    <p class:list={['flow__node', nova && 'flow__node--nova']}>
                      {nova && (
                        <span class="flow__num" aria-label={`Nova touchpoint ${nova}`}>
                          <OuraStar size="0.75rem" />
                          {nova}
                        </span>
                      )}
                      {l}
                    </p>
                    {grand.length > 0 && (
                      <ul class="flow__grand" role="list">
                        {grand.map(({ label: g }) => (
                          <li class="flow__node flow__node--leaf">{g}</li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</figure>

<style>
  .flow {
    margin-block: var(--space-6);
    padding: var(--space-6) var(--space-5);
    border-radius: 1.25rem;
    background: #1a3864;
    color: #fff;
    font-family: var(--case-font, var(--font-sans));
  }

  .flow__caption {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    font-size: var(--text-h3);
  }

  .flow__caption :global(.oura-star) {
    position: relative;
    top: 0.15em;
  }

  /* --line: the connector color */
  .flow__tree {
    --line: rgb(255 255 255 / 0.7);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .flow__node {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border-radius: 0.375rem;
    background: #fff;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    color: #2f4a73;
  }

  .flow__node--start {
    padding-inline: var(--space-5);
  }

  /* Nova touchpoints: the slide's light blue, with navy text (5:1) */
  .flow__node--nova {
    background: #6fcbff;
    color: #1a3864;
  }

  .flow__num {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    padding: 0.1em 0.45em;
    border-radius: var(--radius-pill);
    background: #1a3864;
    font-size: 0.75rem;
    color: #fff;
  }

  .flow__node--leaf {
    min-height: 2.25rem;
    font-size: 0.6875rem;
    background: rgb(255 255 255 / 0.9);
  }

  /* Connectors: a short line down from each node to the row below */
  .flow__node--start::after,
  .flow__node--tab::after {
    content: '';
  }

  .flow__branches {
    position: relative;
    display: grid;
    gap: var(--space-5);
    width: 100%;
    margin: var(--space-5) 0 0;
    padding: var(--space-5) 0 0;
    border-top: 2px solid var(--line);
    list-style: none;
  }

  .flow__branch {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .flow__children,
  .flow__grand {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0 0 0 var(--space-4);
    border-left: 2px solid var(--line);
    list-style: none;
  }

  .flow__children > li {
    display: grid;
    gap: var(--space-2);
  }

  .flow__grand {
    grid-template-columns: repeat(3, 1fr);
    margin-left: var(--space-3);
  }

  @media (min-width: 64rem) {
    .flow {
      padding: var(--space-7);
    }

    /* Tabs side by side: Today gets more room, since it holds two Nova touchpoints */
    .flow__branches {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
      gap: var(--space-5);
      margin-top: var(--space-7);
      padding-top: 0;
      border-top: 0;
    }

    /* A rail across the tops of the four tabs, joined to the start node */
    .flow__branches::before {
      content: '';
      position: absolute;
      top: calc(var(--space-5) * -1);
      /* From the center of the first column to the center of the last */
      left: 17%;
      right: 11%;
      border-top: 2px solid var(--line);
    }

    .flow__tree > .flow__node--start {
      position: relative;
    }

    .flow__tree > .flow__node--start::after {
      position: absolute;
      top: 100%;
      left: 50%;
      height: var(--space-5);
      border-left: 2px solid var(--line);
    }

    .flow__node--tab {
      position: relative;
    }

    .flow__node--tab::after {
      position: absolute;
      bottom: 100%;
      left: 50%;
      height: var(--space-5);
      border-left: 2px solid var(--line);
    }

    .flow__grand {
      grid-template-columns: 1fr;
    }
  }
</style>
