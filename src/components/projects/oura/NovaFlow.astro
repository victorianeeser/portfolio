---
// Where Nova fits in: the user flow from the Figma slide, rebuilt as a branching flowchart.
// A key of the three Nova touchpoints comes first; then, on wide screens, an SVG diagram on
// navy with elbow arrows from "Log in / open app" down through the four tabs, the Nova boxes
// in light blue and numbered. Phones get the simpler tree passed in the default slot instead,
// since the wide diagram would be too small to read there.
import SectionTitle from '../../case/SectionTitle.astro';
import OuraStar from './OuraStar.astro';

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  intro: string;
  touchpoints: { title: string; text: string }[];
}

const { id, eyebrow, title, intro, touchpoints } = Astro.props;

// Diagram layout, in SVG units (viewBox 1240 × 410)
type Box = { x: number; y: number; w: number; h: number; lines: string[]; kind: 'start' | 'tab' | 'nova' | 'plain'; n?: number };
const W = 124;
const H = 56;
const box = (cx: number, y: number, lines: string[], kind: Box['kind'], n?: number, w = W, h = H): Box => ({ x: cx - w / 2, y, w, h, lines, kind, n });

const tabs = [
  { cx: 210, label: 'Today' },
  { cx: 580, label: 'Readiness' },
  { cx: 850, label: 'Sleep' },
  { cx: 1120, label: 'Activity' },
];
const ROOT = (tabs[0].cx + tabs[tabs.length - 1].cx) / 2;
// A score tab's two children: the wider Nova breakdown on the left, its stats on the right
const LEFT = -70;
const RIGHT = 60;

const boxes: Box[] = [
  box(ROOT, 10, ['Log in / open app'], 'start', undefined, 180, 50),
  ...tabs.map(({ cx, label }) => box(cx, 120, [label], 'tab', undefined, 120, 50)),
  // Today's children
  box(70, 230, ['Nova Chat'], 'nova', 1),
  box(210, 230, ['Nova Insights'], 'nova', 2),
  box(355, 230, ['Readiness, Sleep', '& Activity'], 'plain', undefined, 134),
  box(210, 340, ['Insights for', 'each score'], 'plain'),
  // Each score tab: its Nova breakdown and its stats
  ...tabs.slice(1).flatMap(({ cx, label }) => [
    box(cx + LEFT, 230, [label, 'Nova breakdown'], 'nova', 3, 132),
    box(cx + RIGHT, 230, [label, 'stats'], 'plain', undefined, 104),
  ]),
];

// Elbow connectors: from a parent's bottom center, down, across, and down into each child
const elbow = (px: number, py: number, kids: number[], ky: number) => {
  const mid = (py + ky) / 2;
  return kids.map((kx) => `M${px} ${py}V${mid}H${kx}V${ky - 3}`).join('');
};
const paths = [
  elbow(ROOT, 60, tabs.map((t) => t.cx), 120),
  elbow(210, 170, [70, 210, 355], 230),
  `M210 286V${340 - 3}`,
  ...tabs.slice(1).map(({ cx }) => elbow(cx, 170, [cx + LEFT, cx + RIGHT], 230)),
];
---

<section class="nova-flow case-wide" id={id}>
  <div class="nova-flow__head">
    <p class="eyebrow nova-flow__eyebrow">{eyebrow}</p>
    <SectionTitle>{title}</SectionTitle>
    <p class="nova-flow__intro">{intro}</p>
  </div>

  <ol class="nova-flow__key" role="list">
    {
      touchpoints.map(({ title, text }, i) => (
        <li>
          <span class="nova-flow__badge" aria-hidden="true">
            <OuraStar size="0.85rem" />
            {i + 1}
          </span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))
    }
  </ol>

  <figure class="nova-flow__chart">
    <svg viewBox="0 0 1240 410" role="img" aria-labelledby={`${id}-chart-title`}>
      <title id={`${id}-chart-title`}>
        User flow: opening the app leads to four tabs. Today leads to Nova Chat (1), Nova Insights (2) with insights for each score, and the Readiness, Sleep and Activity scores. Readiness, Sleep and Activity each lead to their Nova breakdown (3) and their stats.
      </title>
      <defs>
        <marker id={`${id}-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 10 5 0 10z" fill="#d5deeb" />
        </marker>
      </defs>
      {paths.map((d) => <path d={d} fill="none" stroke="#d5deeb" stroke-width="2" marker-end={`url(#${id}-arrow)`} />)}
      {
        boxes.map(({ x, y, w, h, lines, kind, n }) => (
          <g class={`nova-flow__box nova-flow__box--${kind}`}>
            <rect x={x} y={y} width={w} height={h} rx="10" />
            {lines.map((line, i) => (
              <text x={x + w / 2} y={y + h / 2 + (i - (lines.length - 1) / 2) * 17 + 5} text-anchor="middle">
                {line}
              </text>
            ))}
            {n && (
              <g class="nova-flow__num">
                <circle cx={x + 4} cy={y + 4} r="13" />
                <text x={x + 4} y={y + 9} text-anchor="middle">
                  {n}
                </text>
              </g>
            )}
          </g>
        ))
      }
    </svg>
  </figure>

  <div class="nova-flow__small">
    <slot />
  </div>
</section>

<style>
  .nova-flow {
    margin-block: var(--space-8);
  }

  .nova-flow__eyebrow {
    margin-bottom: var(--space-3);
    color: #2f4a73;
  }

  .nova-flow__intro {
    max-width: var(--container-prose);
    margin-top: var(--space-4);
    color: var(--color-text-secondary);
  }

  /* The key: what Nova does at each touchpoint */
  .nova-flow__key {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .nova-flow__key li {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--oura-tint, #eef3fa);
  }

  .nova-flow__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    width: fit-content;
    padding: 0.15em 0.65em;
    border-radius: var(--radius-pill);
    background: #2f4a73;
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    color: #ffffff;
  }

  .nova-flow__badge :global(svg) {
    color: #9fd0f7;
  }

  .nova-flow__key h3 {
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    color: #2f4a73;
  }

  .nova-flow__key p {
    font-size: var(--text-small);
    color: var(--oura-quiet, #56657c);
  }

  /* The diagram (wide screens only) */
  .nova-flow__chart {
    display: none;
    margin: var(--space-5) 0 0;
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-lg, 1.25rem);
    background: #2f4a73;
  }

  .nova-flow__chart svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .nova-flow__box text {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    fill: #2f4a73;
  }

  .nova-flow__box rect {
    fill: #ffffff;
  }

  .nova-flow__box--start rect {
    fill: #ffffff;
    stroke: #9fd0f7;
    stroke-width: 3;
  }

  .nova-flow__box--tab text {
    font-size: 16px;
  }

  /* Nova touchpoints in the slide's light blue */
  .nova-flow__box--nova rect {
    fill: #9fd0f7;
  }

  .nova-flow__num circle {
    fill: #ffffff;
    stroke: #2f4a73;
    stroke-width: 2;
  }

  .nova-flow__num text {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0;
  }

  .nova-flow__small {
    margin-top: var(--space-5);
  }

  @media (min-width: 48rem) {
    .nova-flow__key {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .nova-flow__chart {
      display: block;
    }

    .nova-flow__small {
      display: none;
    }
  }
</style>
