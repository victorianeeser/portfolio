---
// Usability test findings: score rings for the questions that went well, then the key
// finding in a dark card with its own ring. Each ring is drawn as SVG from the average
// of the responses, so the chart always matches the numbers listed under it.
import OuraStar from './OuraStar.astro';

interface Finding {
  question: string;
  scale: string;
  responses: number[];
  text: string;
}

interface Props {
  items: Finding[];
  keyFinding: Finding & { highlight?: string };
}

const { items, keyFinding } = Astro.props;

const avg = (r: number[]) => Math.round((r.reduce((a, b) => a + b, 0) / r.length) * 10) / 10;
const R = 42;
const C = 2 * Math.PI * R;

// Highlight one phrase of the key finding in coral, as in the slide
const [before, after] =
  keyFinding.highlight && keyFinding.text.includes(keyFinding.highlight)
    ? keyFinding.text.split(keyFinding.highlight)
    : [keyFinding.text, undefined];
---

<div class="findings2 case-wide">
  <ul class="findings2__list" role="list">
    {
      items.map(({ question, scale, responses, text }) => {
        const a = avg(responses);
        return (
          <li class="findings2__item">
            <h4>{question}</h4>
            <p class="findings2__scale">{scale}</p>
            <div class="findings2__body">
              <figure class="findings2__ring" data-tone="light">
                <svg viewBox="0 0 100 100" aria-hidden="true">
                  <circle cx="50" cy="50" r={R} class="findings2__track" />
                  <circle cx="50" cy="50" r={R} class="findings2__arc" stroke-dasharray={`${(C * a) / 10} ${C}`} transform="rotate(-90 50 50)" />
                </svg>
                <figcaption>
                  <strong>{a}</strong>
                  <span>out of 10</span>
                </figcaption>
              </figure>
              <div>
                <p>{text}</p>
                <p class="findings2__responses">Responses: {responses.join(', ')}</p>
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>

  <section class="findings2__key" aria-labelledby="key-finding-title">
    <p class="findings2__eyebrow" id="key-finding-title">Key finding</p>
    <div class="findings2__key-grid">
      <div>
        <h4>{keyFinding.question}</h4>
        <p class="findings2__scale">{keyFinding.scale}</p>
        <div class="findings2__body">
          <figure class="findings2__ring" data-tone="key">
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <circle cx="50" cy="50" r={R} class="findings2__track" />
              <circle
                cx="50"
                cy="50"
                r={R}
                class="findings2__arc"
                stroke-dasharray={`${(C * avg(keyFinding.responses)) / 10} ${C}`}
                transform="rotate(-90 50 50)"
              />
            </svg>
            <figcaption>
              <strong>{avg(keyFinding.responses)}</strong>
              <span>out of 10</span>
            </figcaption>
          </figure>
          <p class="findings2__responses">Responses: {keyFinding.responses.join(', ')}</p>
        </div>
      </div>
      <p class="findings2__insight">
        <OuraStar size="1.25rem" />
        <span>
          {before}
          {after !== undefined && <span class="findings2__coral">{keyFinding.highlight}</span>}
          {after}
        </span>
      </p>
    </div>
  </section>
</div>

<style>
  .findings2 {
    margin-block: var(--space-6);
    font-family: var(--case-font, var(--font-sans));
    color: #2f4a73;
  }

  .findings2__list {
    display: grid;
    gap: var(--space-6);
    margin: 0 0 var(--space-7);
    padding: 0;
    list-style: none;
  }

  .findings2__item {
    padding-left: var(--space-5);
    border-left: 3px solid #2f4a73;
  }

  .findings2 h4 {
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    line-height: 1.4;
    color: inherit;
  }

  .findings2__scale {
    margin-top: var(--space-1);
    font-size: var(--text-small);
    color: var(--oura-quiet, #56657c);
  }

  .findings2__body {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-4);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .findings2__responses {
    margin-top: var(--space-2);
    color: var(--oura-quiet, #56657c);
  }

  /* Score ring: the light blue arc shows the average out of 10 */
  .findings2__ring {
    position: relative;
    flex: none;
    width: 7.5rem;
    margin: 0;
  }

  .findings2__ring svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .findings2__track,
  .findings2__arc {
    fill: none;
    stroke-width: 10;
  }

  .findings2__track { stroke: #e3eaf3; }
  .findings2__arc { stroke: #6fcbff; stroke-linecap: round; }

  .findings2__ring figcaption {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    line-height: 1.1;
  }

  .findings2__ring strong {
    font-size: var(--text-h2);
    color: inherit;
  }

  .findings2__ring span {
    font-size: 0.6875rem;
  }

  /* The key finding: a dark card with a coral ring */
  .findings2__key {
    padding: var(--space-6);
    border-radius: 1.5rem;
    background: #23395b;
    color: #fff;
  }

  .findings2__eyebrow {
    margin-bottom: var(--space-4);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: #6fcbff;
  }

  .findings2__key .findings2__scale,
  .findings2__key .findings2__responses {
    color: #d5deeb;
  }

  .findings2__key .findings2__track { stroke: rgb(255 255 255 / 0.15); }
  .findings2__key .findings2__arc { stroke: #ff8a80; }

  .findings2__key-grid {
    display: grid;
    gap: var(--space-6);
  }

  .findings2__insight {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-h2);
    line-height: 1.4;
  }

  .findings2__insight :global(.oura-star) {
    position: relative;
    top: 0.15em;
  }

  /* Coral from the slide, lightened so it reads on the dark card */
  .findings2__coral {
    color: #ff8a80;
  }

  @media (min-width: 48rem) {
    .findings2__list {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  @media (min-width: 64rem) {
    .findings2__key {
      padding: var(--space-7) var(--space-8);
    }

    .findings2__key-grid {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--space-8);
      align-items: center;
    }
  }
</style>
