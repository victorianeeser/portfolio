---
// Oura title section, rebuilt from the Figma cover: the misty mountain photo, the two
// redesigned screens on tilted phones (a 3D mockup, kept as one image), and the six
// feature labels with their leader lines as real text.
// Desktop uses the slide's 1920×1080 layout as percentages. On phones the labels move
// into a list under the image, where they stay readable.
import { Image } from 'astro:assets';
import mist from '../../../assets/projects/oura/hero-mist.jpg';
import phones from '../../../assets/projects/oura/hero-phones.png';

// x, y: where the label text starts (left labels: where it ends); line: [start, end] x
// of the leader line. All in slide pixels.
const labels = [
  { text: 'Score Quick Actions', side: 'left', x: 421.8, y: 399.8, line: [451.4, 638.5], ly: 414.8 },
  { text: 'Daily Steps Progress', side: 'left', x: 463.7, y: 529.4, line: [493.3, 680.4], ly: 544.4 },
  { text: 'Nova Insights, your AI guide', side: 'left', x: 503, y: 694.4, line: [532.6, 719.6], ly: 709.4 },
  { text: 'Readiness, Sleep, & Activity Score', side: 'right', x: 1481.4, y: 232.9, line: [1263.8, 1450.9], ly: 262.9 },
  { text: 'Daily Metrics', side: 'right', x: 1437.5, y: 443.9, line: [1220, 1407], ly: 458.9 },
  { text: 'Readiness, Sleep, & Activity Contributors', side: 'right', x: 1391.5, y: 610.8, line: [1173.9, 1361], ly: 625.8 },
] as const;

const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
---

<figure class="oura-hero">
  <div class="oura-hero__stage">
    <Image src={mist} alt="" class="oura-hero__bg" widths={[800, 1400, 1700]} sizes="(min-width: 75rem) 1200px, 100vw" loading="eager" />
    <Image
      src={phones}
      alt="Two redesigned Oura screens on phones: the Today home screen and the Readiness screen"
      class="oura-hero__phones"
      sizes="(min-width: 75rem) 460px, 60vw"
      loading="eager"
    />
    {
      labels.map(({ text, side, x, y, line, ly }) => (
        <>
          <span class="oura-hero__line" data-side={side} style={`left: ${pct(line[0], 1920)}; width: ${pct(line[1] - line[0], 1920)}; top: ${pct(ly, 1080)}`} aria-hidden="true" />
          <span
            class="oura-hero__label"
            data-side={side}
            style={side === 'left' ? `right: ${pct(1920 - x, 1920)}; top: ${pct(y, 1080)}` : `left: ${pct(x, 1920)}; top: ${pct(y, 1080)}`}
            aria-hidden="true"
          >
            {text}
          </span>
        </>
      ))
    }
  </div>

  <figcaption class="oura-hero__legend">
    <ul role="list">
      {labels.map(({ text }) => <li>{text}</li>)}
    </ul>
  </figcaption>
</figure>

<style>
  .oura-hero {
    display: block;
    margin: 0;
    font-family: var(--case-font, var(--font-sans));
  }

  .oura-hero__stage {
    position: relative;
    container-type: inline-size;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    background: #9fb6cc;
  }

  .oura-hero__stage :global(img) {
    position: absolute;
    max-width: none;
    border-radius: 0;
  }

  .oura-hero :global(.oura-hero__bg) {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Phones: the mockup centered and larger; desktop: the slide's spot (31% from left, 10% down) */
  .oura-hero :global(.oura-hero__phones) {
    left: 50%;
    top: 10%;
    width: 68%;
    height: auto;
    transform: translateX(-50%);
  }

  .oura-hero__line,
  .oura-hero__label {
    position: absolute;
    display: none;
  }

  .oura-hero__line {
    border-top: 1.5px solid currentColor;
  }

  .oura-hero__label {
    max-width: 14%;
    font-size: 1.25cqw;
    line-height: 1.25;
    transform: translateY(-0.1em);
  }

  [data-side='left'] {
    color: #2f4a73;
    text-align: right;
  }

  /* Left labels are wider in the slide, so they stay on one line */
  .oura-hero__label[data-side='left'] {
    max-width: 19%;
  }

  [data-side='right'] {
    color: #fff;
  }

  .oura-hero__line[data-side='right'] {
    color: rgb(255 255 255 / 0.85);
  }

  .oura-hero__legend ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
    color: var(--case-heading-1, #2f4a73);
  }

  .oura-hero__legend li::before {
    content: '—';
    margin-right: var(--space-2);
    color: var(--case-heading-1, #2f4a73);
  }

  @media (min-width: 48rem) {
    .oura-hero__stage {
      aspect-ratio: 16 / 9;
    }

    .oura-hero :global(.oura-hero__phones) {
      left: 30.98%;
      top: 10.07%;
      width: 38.04%;
      transform: none;
    }

    .oura-hero__line,
    .oura-hero__label {
      display: block;
    }

    /* The labels are on the image now, so the list is only for screen readers */
    .oura-hero__legend {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
</style>
