---
// App screens in a phone with numbered pins on the parts being discussed, and numbered
// note cards. Hovering or focusing a note lights up its pin (and the reverse).
//
// With one phone, notes sit on both sides of it on wide screens, like the slide's
// callouts: give each note `side: 'left'` or `'right'`. With two phones (before / after),
// the notes stack beside them. Pins are percentages of the screen (x from the left, y from
// the top). Wrap words in **double asterisks** to bold them in a note.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import frame from '../../../assets/projects/oura/phone-frame.png';

interface Phone {
  src: ImageMetadata;
  alt: string;
  label?: string; // e.g. "Before"
  pins?: { x: number; y: number }[];
}

interface Note {
  title?: string;
  text: string;
  side?: 'left' | 'right';
}

interface Props {
  phones: Phone[];
  notes: Note[];
}

const { phones, notes } = Astro.props;
const flank = phones.length === 1;

const escape = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
const rich = (s: string) => escape(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

const numbered = notes.map((note, i) => ({ ...note, n: i + 1 }));
const groups = flank
  ? [
      { side: 'left', items: numbered.filter((n) => n.side === 'left') },
      { side: 'right', items: numbered.filter((n) => n.side !== 'left') },
    ]
  : [{ side: 'all', items: numbered }];
---

<div class="pins case-wide" data-layout={flank ? 'flank' : 'stack'}>
  {
    groups.map(({ side, items }) => (
      <ol class="pins__notes" data-side={side} role="list">
        {items.map(({ title, text, n }) => (
          <li class="pins__note" data-pin={n} tabindex="0" style={`order: ${n}`}>
            <span class="pins__num" aria-hidden="true">{n}</span>
            <div>
              {title && <h4>{title}</h4>}
              <p set:html={rich(text)} />
            </div>
          </li>
        ))}
      </ol>
    ))
  }

  <div class="pins__phones" data-count={phones.length}>
    {
      phones.map(({ src, alt, label, pins = [] }) => (
        <figure class:list={['pins__phone', label?.toLowerCase() === 'before' && 'is-before']}>
          {label && <figcaption class="pins__label">{label}</figcaption>}
          <div class="pins__device">
            <Image src={frame} alt="" class="pins__frame" widths={[400, 800]} sizes="(min-width: 64rem) 300px, 45vw" />
            <Image src={src} alt={alt} class="pins__screen" sizes="(min-width: 64rem) 270px, 40vw" />
            {pins.map(({ x, y }, i) => (
              <span
                class="pins__pin"
                data-pin={i + 1}
                style={`left: ${5.27 + (x * 89.65) / 100}%; top: ${2.08 + (y * 95.87) / 100}%`}
                aria-hidden="true"
              >
                {i + 1}
              </span>
            ))}
          </div>
        </figure>
      ))
    }
  </div>
</div>

<script>
  // Link each note to its pin: hovering or focusing either one highlights both
  document.querySelectorAll<HTMLElement>('.pins').forEach((root) => {
    const set = (n: string | undefined, on: boolean) =>
      root.querySelectorAll<HTMLElement>(`[data-pin="${n}"]`).forEach((el) => el.classList.toggle('is-active', on));
    root.querySelectorAll<HTMLElement>('[data-pin]').forEach((el) => {
      const n = el.dataset.pin;
      ['mouseenter', 'focus'].forEach((e) => el.addEventListener(e, () => set(n, true)));
      ['mouseleave', 'blur'].forEach((e) => el.addEventListener(e, () => set(n, false)));
    });
  });
</script>

<style>
  .pins {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    margin-block: var(--space-6);
    font-family: var(--case-font, var(--font-sans));
    color: var(--case-heading-1, var(--color-text));
  }

  /* Phones come first on small screens, so the pins are seen before the notes */
  .pins__phones {
    order: -1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: end;
    justify-self: center;
    width: min(100%, 17rem);
  }

  .pins__phones[data-count='2'] {
    grid-template-columns: 0.8fr 1fr;
    width: min(100%, 30rem);
  }

  .pins__phone {
    margin: 0;
  }

  /* The "before" phone is smaller and quieter, so the eye goes to the redesign */
  .pins__phone.is-before .pins__device {
    opacity: 0.85;
  }

  .pins__label {
    margin-bottom: var(--space-3);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-align: center;
    text-transform: uppercase;
  }

  .pins__phone:not(.is-before) .pins__label {
    width: fit-content;
    margin-inline: auto;
    padding: 0.15em 0.8em;
    border-radius: var(--radius-pill);
    background: var(--case-heading-1, #2f4a73);
    color: var(--color-bg);
  }

  /* The frame image is the phone's size (1710×3460); the screen sits in its bezel, on top */
  .pins__device {
    position: relative;
    aspect-ratio: 1710 / 3460;
    filter: drop-shadow(0 1.5rem 2rem rgb(47 74 115 / 0.25));
  }

  .pins__device :global(img) {
    position: absolute;
    max-width: none;
  }

  .pins__device :global(.pins__frame) {
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 0;
  }

  .pins__device :global(.pins__screen) {
    left: 5.27%;
    top: 2.08%;
    width: 89.65%;
    height: 95.87%;
    border-radius: 12% / 5.6%;
    object-fit: cover;
    object-position: top;
  }

  .pins__pin,
  .pins__num {
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--case-heading-1, #2f4a73);
    font-weight: var(--weight-bold);
    color: var(--color-bg);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  /* Smaller on phones, where the screens are small */
  .pins__pin {
    position: absolute;
    width: 1.25rem;
    height: 1.25rem;
    border: 2px solid #fff;
    font-size: 0.6875rem;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 4px rgb(255 255 255 / 0.25);
  }

  .pins__pin.is-active {
    background: #fff;
    color: var(--case-heading-1, #2f4a73);
    transform: translate(-50%, -50%) scale(1.3);
  }

  .pins__notes {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Small screens: both sides merge into one list in number order, under the phone */
  .pins[data-layout='flank'] {
    row-gap: var(--space-3);
  }

  .pins[data-layout='flank'] .pins__notes {
    display: contents;
  }

  .pins[data-layout='flank'] .pins__phones {
    margin-bottom: var(--space-4);
  }

  /* Each note is a white card on the cream background */
  .pins__note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-4);
    border: var(--border-width) solid rgb(47 74 115 / 0.12);
    border-radius: 0.875rem;
    background: var(--color-bg);
    box-shadow: 0 0.25rem 1rem rgb(47 74 115 / 0.06);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .pins__note.is-active {
    border-color: var(--case-heading-1, #2f4a73);
    box-shadow: 0 0.5rem 1.5rem rgb(47 74 115 / 0.15);
  }

  .pins__note.is-active .pins__num {
    transform: scale(1.15);
  }

  .pins__num {
    width: 1.75rem;
    height: 1.75rem;
    font-size: 0.8125rem;
  }

  .pins .pins__note h4 {
    margin-bottom: var(--space-1);
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    color: inherit;
  }

  .pins__note :global(strong) {
    color: inherit;
  }

  .pins__note p {
    font-size: var(--text-small);
    line-height: 1.5;
  }

  @media (min-width: 64rem) {
    .pins {
      gap: var(--space-7);
    }

    .pins__pin {
      width: 1.75rem;
      height: 1.75rem;
      font-size: 0.8125rem;
    }

    /* One phone: notes flank it, like the slide's callouts */
    .pins[data-layout='flank'] {
      grid-template-columns: 1fr 17rem 1fr;
    }

    .pins[data-layout='flank'] .pins__phones {
      order: 0;
      grid-column: 2;
      grid-row: 1;
      width: 100%;
    }

    .pins[data-layout='flank'] .pins__notes {
      display: grid;
    }

    .pins[data-layout='flank'] .pins__phones {
      margin-bottom: 0;
    }

    .pins[data-layout='flank'] .pins__notes[data-side='left'] {
      grid-column: 1;
      grid-row: 1;
    }

    .pins[data-layout='flank'] .pins__notes[data-side='right'] {
      grid-column: 3;
      grid-row: 1;
    }

    /* Before / after: phones on the left, the list of changes beside them */
    .pins[data-layout='stack'] {
      grid-template-columns: 30rem 1fr;
    }

    .pins[data-layout='stack'] .pins__phones {
      order: 0;
      grid-column: 1;
      grid-row: 1;
      width: 100%;
    }
  }
</style>
