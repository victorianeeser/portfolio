---
// The problem: three statements led by the slides' star, then a row of current-app screens
// that shows how much data the app puts in front of people. The row scrolls sideways on
// phones. Wrap words in **double asterisks** to bold them.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import OuraStar from './OuraStar.astro';

interface Props {
  points: string[];
  screens: { src: ImageMetadata; alt: string }[];
}

const { points, screens } = Astro.props;

const escape = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
const rich = (s: string) => escape(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

<div class="problem case-wide">
  <ul class="problem__points" role="list">
    {
      points.map((p) => (
        <li>
          <OuraStar size="1.25rem" />
          <span set:html={rich(p)} />
        </li>
      ))
    }
  </ul>

  <ul class="problem__screens" role="list" tabindex="0" aria-label="Current Oura app screens, scrollable">
    {
      screens.map(({ src, alt }) => (
        <li>
          <Image src={src} alt={alt} widths={[300, 600]} sizes="(min-width: 64rem) 160px, 40vw" />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .problem {
    margin-block: var(--space-5) var(--space-6);
    font-family: var(--case-font, var(--font-sans));
    color: var(--case-heading-1, var(--color-text));
  }

  .problem__points {
    display: grid;
    gap: var(--space-4);
    max-width: var(--container-prose);
    margin: 0 0 var(--space-7);
    padding: 0;
    list-style: none;
    font-size: var(--text-h3);
  }

  .problem__points li {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }

  .problem__points :global(strong) {
    color: inherit;
  }

  .problem__points :global(.oura-star) {
    position: relative;
    top: 0.2em;
  }

  .problem__screens {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 40%;
    gap: var(--space-3);
    margin: 0;
    padding: 0 0 var(--space-3);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    list-style: none;
  }

  .problem__screens li {
    scroll-snap-align: start;
  }

  .problem__screens :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }

  @media (min-width: 48rem) {
    .problem__points {
      font-size: var(--text-h2);
    }

    .problem__screens {
      grid-auto-columns: minmax(0, 1fr);
      overflow: visible;
    }
  }
</style>
