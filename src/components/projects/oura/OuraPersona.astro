---
// Oura persona, from the Figma "Persona" slide, in three columns of one height: a profile
// card (photo, name, and the About lines), Likes and Wants as matching cards with the slides'
// star as bullets (Wants, the one that drives the design, in the light blue tint), and a navy
// personality panel whose sliders spread to fill it. Wrap words in **double asterisks** to
// bold them.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import OuraStar from './OuraStar.astro';

interface Props {
  name: string;
  image: ImageMetadata;
  imageAlt: string;
  /** The first line is the short tagline under the name (e.g. "20, college student") */
  about: string[];
  likes: string[];
  wants: string[];
  /** Each trait: the two ends and where the person sits between them (0–100) */
  traits: { from: string; to: string; value: number }[];
}

const { name, image, imageAlt, about, likes, wants, traits } = Astro.props;
const [tagline, ...bio] = about;

const escape = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
const rich = (s: string) => escape(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

const lean = (from: string, to: string, v: number) =>
  v === 50 ? 'balanced' : `leans ${v > 50 ? to : from}`;
---

<div class="opersona case-wide">
  <section class="opersona__profile">
    <Image src={image} alt={imageAlt} class="opersona__photo" widths={[500, 900]} sizes="(min-width: 64rem) 340px, 100vw" />
    <div class="opersona__who">
      <h3 class="opersona__name">{name}</h3>
      <p class="opersona__tagline">{tagline}</p>
      {bio.map((line) => <p class="opersona__bio" set:html={rich(line)} />)}
    </div>
  </section>

  <div class="opersona__cards">
    {
      [
        { title: 'Likes', items: likes, tone: 'white' },
        { title: 'Wants', items: wants, tone: 'tint' },
      ].map(({ title, items, tone }) => (
        <section class="opersona__card" data-tone={tone}>
          <h4>{title}</h4>
          <ul role="list">
            {items.map((i) => (
              <li>
                <OuraStar size="0.8rem" />
                <span set:html={rich(i)} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <section class="opersona__traits">
    <h4>Personality</h4>
    <ul role="list">
      {
        traits.map(({ from, to, value }) => (
          <li>
            <span class="visually-hidden">{`${from} to ${to}: ${lean(from, to, value)}`}</span>
            <span class="opersona__ends" aria-hidden="true">
              <span>{from}</span>
              <span>{to}</span>
            </span>
            <span class="opersona__track" aria-hidden="true">
              <span class="opersona__fill" style={`width: ${value}%`} />
              <span class="opersona__marker" style={`left: ${value}%`}>
                <OuraStar size="1.25rem" />
              </span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</div>

<style>
  .opersona {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-6);
    font-family: var(--case-font, var(--font-sans));
    color: #2f4a73;
  }

  /* Profile: photo on top, who she is underneath, in one white card */
  .opersona__profile {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: 1rem;
    background: #ffffff;
    box-shadow: inset 0 0 0 1px rgb(47 74 115 / 0.1);
  }

  .opersona__profile :global(.opersona__photo) {
    display: block;
    width: 100%;
    height: 17rem;
    border-radius: 0;
    object-fit: cover;
    object-position: 50% 25%;
  }

  .opersona__who {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .opersona__name {
    font-size: var(--text-h2);
    font-weight: var(--weight-medium);
    color: inherit;
  }

  .opersona__tagline {
    width: fit-content;
    padding: 0.15em 0.75em;
    border-radius: var(--radius-pill);
    background: var(--oura-tint, #eef3fa);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
  }

  .opersona__bio {
    margin-top: var(--space-2);
    font-size: var(--text-small);
    line-height: 1.55;
    color: var(--oura-quiet, #56657c);
  }

  /* Likes and Wants */
  .opersona__cards {
    display: grid;
    gap: var(--space-4);
    grid-template-rows: auto 1fr;
  }

  .opersona__card {
    padding: var(--space-5);
    border-radius: 1rem;
  }

  .opersona__card[data-tone='white'] {
    background: #ffffff;
    box-shadow: inset 0 0 0 1px rgb(47 74 115 / 0.1);
  }

  .opersona__card[data-tone='tint'] {
    background: #dce8f7;
  }

  .opersona h4 {
    margin-bottom: var(--space-3);
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: inherit;
  }

  .opersona__card ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .opersona__card li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2);
    align-items: baseline;
  }

  .opersona__card li :global(.oura-star) {
    position: relative;
    top: 0.1em;
    color: #4f74a8;
  }

  .opersona__card :global(strong) {
    color: inherit;
  }

  /* Personality: a navy panel of sliders, spread to fill its height */
  .opersona__traits {
    display: grid;
    grid-template-rows: auto 1fr;
    padding: var(--space-6);
    border-radius: 1rem;
    background: #2f4a73;
    color: #fff;
  }

  .opersona__traits ul {
    display: grid;
    align-content: space-between;
    gap: var(--space-5);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .opersona__ends {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-2);
    font-size: var(--text-small);
    color: #d5deeb;
  }

  .opersona__track {
    position: relative;
    display: block;
    height: 4px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.18);
  }

  .opersona__fill {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 2px;
    background: #9fd0f7;
  }

  .opersona__marker {
    position: absolute;
    top: 50%;
    display: grid;
    color: #ffffff;
    transform: translate(-50%, -50%);
  }

  @media (min-width: 48rem) {
    .opersona {
      grid-template-columns: 1fr 1fr;
    }

    .opersona__traits {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .opersona {
      grid-template-columns: 0.9fr 1.15fr 1fr;
      align-items: stretch;
    }

    .opersona__traits {
      grid-column: auto;
    }
  }
</style>
