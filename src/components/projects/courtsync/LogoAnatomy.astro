---
// Logo breakdown: each card spotlights one part of the CourtSync logo.
// The SVGs are inlined so parts of the wordmark can be faded with CSS.
import wordmarkRaw from '../../../assets/projects/courtsync/wordmark.svg?raw';
import csMarkRaw from '../../../assets/projects/courtsync/cs-mark.svg?raw';

// Tag the wordmark's two parts ("COURT" is white, "SYNC" is blue) so CSS can style each
const wordmark = wordmarkRaw
  .replace(/<svg /, '<svg aria-hidden="true" ')
  .replaceAll('fill="white"', 'fill="currentColor" data-part="court"')
  .replaceAll('fill="#015AFF"', 'data-part="sync"');
const csMark = csMarkRaw.replace(/<svg /, '<svg aria-hidden="true" ').replaceAll('fill="white"', 'fill="currentColor"');

const parts = [
  {
    focus: 'court',
    title: 'Strength',
    text: 'The bold, geometric typeface represents stability and power, echoing the structure and discipline of athletic training.',
  },
  {
    focus: 'sync',
    title: 'Motion',
    text: 'The italicized “SYNC” adds movement and forward momentum, symbolizing speed, energy and technological innovation.',
  },
  {
    focus: 'mark',
    title: 'Mark',
    text: 'The “CS” abbreviation is a compact logo mark that adapts easily to app icons, the earbuds themselves and apparel.',
  },
];
---

<ol class="anatomy" role="list">
  {
    parts.map(({ focus, title, text }, i) => (
      <li class="anatomy__card" data-focus={focus}>
        <div class="anatomy__visual">
          <Fragment set:html={focus === 'mark' ? csMark : wordmark} />
        </div>
        <div class="anatomy__body">
          <p class="anatomy__num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </p>
          <h4>{title}</h4>
          <p>{text}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .anatomy {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .anatomy__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--case-surface);
  }

  .anatomy__visual {
    display: grid;
    place-items: center;
    aspect-ratio: var(--ratio-card);
    padding: var(--space-7);
    border-bottom: var(--border-width) solid var(--case-border);
    color: var(--case-text);
  }

  .anatomy__visual :global(svg) {
    width: 100%;
    height: auto;
  }

  .anatomy__visual :global([data-part='sync']) {
    fill: var(--case-accent-1);
  }

  /* Fade the part that isn't being described */
  .anatomy__visual :global([data-part]) {
    transition: opacity var(--duration-base) var(--ease-out);
  }

  [data-focus='court'] .anatomy__visual :global([data-part='sync']),
  [data-focus='sync'] .anatomy__visual :global([data-part='court']) {
    opacity: 0.2;
  }

  [data-focus='mark'] .anatomy__visual {
    color: var(--case-accent-1);
  }

  /* Sized by width (not height) so every card's visual area stays the same size */
  [data-focus='mark'] .anatomy__visual :global(svg) {
    width: 28%;
  }

  .anatomy__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
  }

  .anatomy__num {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    color: var(--case-accent-1-text);
  }

  .anatomy__body h4 {
    font-size: var(--text-h2);
  }

  @media (min-width: 48rem) {
    .anatomy {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
