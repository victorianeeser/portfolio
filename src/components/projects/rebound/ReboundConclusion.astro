---
// Rebound conclusion, rebuilt from the Figma "Conclusion" slide: a bright purple band with
// the closing text, takeaways and next steps, beside the app's home screen in a phone
// that runs off the bottom edge.
// Text is black on the bright purple (7.3:1), as in the slide; white would fail (2.9:1).
import { Image } from 'astro:assets';
import frame from '../../../assets/projects/rebound/phone-frame.png';
import screenHome from '../../../assets/projects/rebound/screen-home.png';

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  takeaways: { title: string; text: string }[];
  nextSteps: string[];
}

const { id, eyebrow, title, takeaways, nextSteps } = Astro.props;
---

<section class="rb-close full-bleed" id={id}>
  <div class="rb-close__inner">
    <div class="rb-close__text">
      <p class="rb-close__eyebrow">{eyebrow}</p>
      <h2 class="rb-close__title">{title}</h2>
      <div class="rb-close__body"><slot /></div>

      <h3 class="rb-close__label">Takeaways</h3>
      <ol class="rb-close__takeaways" role="list">
        {
          takeaways.map(({ title: t, text }, i) => (
            <li>
              <span class="rb-close__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h4>{t}</h4>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>

      <h3 class="rb-close__label">Next steps</h3>
      <ul class="rb-close__next">
        {nextSteps.map((step) => <li>{step}</li>)}
      </ul>
    </div>

    <div class="rb-close__phone" aria-hidden="true">
      <Image src={frame} alt="" class="rb-close__frame" widths={[600, 900]} sizes="(min-width: 64rem) 380px, 70vw" />
      <Image src={screenHome} alt="" class="rb-close__screen" />
    </div>
  </div>
</section>

<style>
  .rb-close {
    grid-column: full;
    overflow: hidden;
    margin-top: var(--space-8);
    background: var(--case-accent-1, #9e86fe);
    color: #000;
    font-family: var(--case-font, var(--font-sans));
  }

  .rb-close__inner {
    display: grid;
    gap: var(--space-7);
    max-width: calc(var(--container-max) + var(--gutter) * 2);
    margin-inline: auto;
    padding: var(--space-8) var(--gutter) 0;
  }

  .rb-close__eyebrow {
    margin-bottom: var(--space-2);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-caps);
  }

  .rb-close__title {
    font-size: var(--text-h1);
    font-weight: var(--weight-medium);
    color: #000;
  }

  .rb-close__body {
    margin-top: var(--space-5);
    font-size: var(--text-h3);
  }

  .rb-close__body :global(p + p) {
    margin-top: var(--space-4);
  }

  .rb-close__label {
    margin-top: var(--space-7);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-width) solid rgb(0 0 0 / 0.3);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .rb-close__takeaways {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .rb-close__takeaways li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-4);
  }

  .rb-close__num {
    grid-row: span 2;
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    line-height: 1.9;
  }

  .rb-close__takeaways h4 {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    color: #000;
  }

  .rb-close__next {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding-left: var(--space-5);
  }

  /* The app's home screen in a phone, cut off by the band's bottom edge */
  .rb-close__phone {
    position: relative;
    justify-self: center;
    width: min(70%, 22rem);
    aspect-ratio: 1400 / 2700;
    margin-bottom: -40%;
  }

  .rb-close__phone :global(img) {
    position: absolute;
    max-width: none;
  }

  .rb-close__phone :global(.rb-close__frame) {
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 0;
  }

  .rb-close__phone :global(.rb-close__screen) {
    left: 6.55%;
    top: 3%;
    width: 87%;
    height: 94.7%;
    border-radius: 8.7% / 4.1%;
    object-fit: cover;
    object-position: top;
  }

  @media (min-width: 64rem) {
    .rb-close__inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-9);
      align-items: start;
    }

    .rb-close__text {
      padding-bottom: var(--space-8);
    }

    /* Sits at the bottom of the band with its lower part cut off, as in the slide */
    .rb-close__phone {
      align-self: end;
      width: min(100%, 24rem);
      margin-bottom: -14rem;
    }
  }
</style>
