---
// Rebound conclusion, rebuilt from the Figma "Conclusion" slide: a bright purple band with
// the closing text beside the app's home screen (a phone cut off at the divider), then
// takeaways and next steps in rows of three across the full width.
// Text is black on the bright purple (7.3:1), as in the slide; white would fail (2.9:1).
import { Image } from 'astro:assets';
import frame from '../../../assets/projects/rebound/phone-frame.png';
import screenHome from '../../../assets/projects/rebound/screen-home.png';

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  takeaways: { title: string; text: string }[];
  nextSteps: string[];
}

const { id, eyebrow, title, takeaways, nextSteps } = Astro.props;
---

<section class="rb-close full-bleed" id={id}>
  <div class="rb-close__inner">
    <div class="rb-close__top">
      <div class="rb-close__text">
        <p class="rb-close__eyebrow">{eyebrow}</p>
        <h2 class="rb-close__title">{title}</h2>
        <div class="rb-close__body"><slot /></div>
      </div>

      {/* The phone rises from the divider below, cut off at the bottom like the slide */}
      <div class="rb-close__stage" aria-hidden="true">
        <div class="rb-close__phone">
          <Image src={screenHome} alt="" class="rb-close__screen" />
          <Image src={frame} alt="" class="rb-close__frame" widths={[600, 900]} sizes="(min-width: 64rem) 340px, 70vw" />
        </div>
      </div>
    </div>

    <div class="rb-close__group">
      <h3 class="rb-close__label">Takeaways</h3>
      <ol class="rb-close__cards" role="list">
        {
          takeaways.map(({ title: t, text }, i) => (
            <li class="rb-close__card">
              <span class="rb-close__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h4>{t}</h4>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="rb-close__group">
      <h3 class="rb-close__label">Next steps</h3>
      <ul class="rb-close__next" role="list">
        {nextSteps.map((step) => <li>{step}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .rb-close {
    grid-column: full;
    margin-top: var(--space-8);
    background: var(--case-accent-1, #9e86fe);
    color: #000;
    font-family: var(--case-font, var(--font-sans));
  }

  .rb-close__inner {
    max-width: calc(var(--container-max) + var(--gutter) * 2);
    margin-inline: auto;
    padding: var(--space-8) var(--gutter);
  }

  /* Intro text beside the phone; the phone's box ends on the divider line */
  .rb-close__top {
    display: grid;
    gap: var(--space-7);
    border-bottom: var(--border-width) solid rgb(0 0 0 / 0.3);
  }

  .rb-close__eyebrow {
    margin-bottom: var(--space-2);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-caps);
  }

  .rb-close__title {
    font-size: var(--text-h1);
    font-weight: var(--weight-medium);
    color: #000;
  }

  .rb-close__body {
    margin-top: var(--space-5);
    font-size: var(--text-h3);
  }

  .rb-close__body :global(p + p) {
    margin-top: var(--space-4);
  }

  .rb-close__stage {
    position: relative;
    overflow: hidden;
    height: 22rem;
  }

  .rb-close__phone {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(80%, 20rem);
    aspect-ratio: 1400 / 2700;
    transform: translateX(-50%);
  }

  .rb-close__phone :global(img) {
    position: absolute;
    max-width: none;
  }

  .rb-close__phone :global(.rb-close__frame) {
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 0;
  }

  .rb-close__phone :global(.rb-close__screen) {
    left: 6.55%;
    top: 3%;
    width: 87%;
    height: 94.7%;
    border-radius: 8.7% / 4.1%;
    object-fit: cover;
    object-position: top;
  }

  .rb-close__group {
    margin-top: var(--space-7);
  }

  .rb-close__label {
    margin-bottom: var(--space-4);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .rb-close__cards,
  .rb-close__next {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Takeaways as black cards with bright purple numbers, echoing the app */
  .rb-close__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border-radius: 1rem;
    background: #000;
    color: var(--case-muted, #dedcdc);
  }

  .rb-close__num {
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    color: var(--case-accent-1, #9e86fe);
  }

  .rb-close__card h4 {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    color: #fff;
  }

  .rb-close__next li {
    display: flex;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 2px solid #000;
    font-weight: var(--weight-medium);
  }

  .rb-close__next li::before {
    content: '→';
  }

  @media (min-width: 48rem) {
    .rb-close__cards,
    .rb-close__next {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .rb-close__top {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--space-8);
    }

    .rb-close__text {
      padding-bottom: var(--space-7);
    }

    /* As tall as the text beside it */
    .rb-close__stage {
      height: auto;
      min-height: 22rem;
    }
  }
</style>
