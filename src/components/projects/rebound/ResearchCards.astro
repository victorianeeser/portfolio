---
// Insights from secondary research: four dark purple cards with a bright purple icon,
// a title and a short summary. Rebuilt from the Figma "Secondary Research" slide.
// Place inside a Panel: one column on phones, two on tablets, four in a row on desktop.
import { Image } from 'astro:assets';
import physical from '../../../assets/projects/rebound/icon-physical.svg';
import brain from '../../../assets/projects/rebound/icon-brain.svg';
import barrier from '../../../assets/projects/rebound/icon-barrier.svg';
import heart from '../../../assets/projects/rebound/icon-heart.svg';

const icons = { physical, brain, barrier, heart };

interface Card {
  icon: keyof typeof icons;
  title: string;
  text: string;
}

interface Props {
  items: Card[];
}

const { items } = Astro.props;
---

<ul class="rb-research" role="list">
  {
    items.map(({ icon, title, text }) => (
      <li class="rb-research__card">
        <span class="rb-research__icon">
          <Image src={icons[icon]} alt="" />
        </span>
        <h4 class="rb-research__title">{title}</h4>
        <p>{text}</p>
      </li>
    ))
  }
</ul>

<style>
  .rb-research {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .rb-research__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border-radius: 1rem;
    background: var(--case-surface);
    color: var(--case-muted);
  }

  /* Icons sit in a 3rem square so titles line up across cards */
  .rb-research__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-3);
  }

  .rb-research__icon :global(img) {
    max-width: 100%;
    max-height: 100%;
    border-radius: 0;
  }

  .rb-research .rb-research__title {
    font-size: var(--text-h2);
    line-height: var(--leading-heading);
  }

  @media (min-width: 40rem) {
    .rb-research {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .rb-research {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
