---
// Rebound title section, rebuilt from the Figma intro slide: a purple-to-black gradient,
// two phones (sign-in and home screens) and the Rebound wordmark.
// Each phone is a frame image with its app screen set inside it, so the screens stay
// sharp. Positions are percentages of the stage, taken from the 1920×1080 slide on
// desktop, with a taller arrangement for phones.
import { Image } from 'astro:assets';
import wordmark from '../../../assets/projects/rebound/wordmark.svg';
import frame from '../../../assets/projects/rebound/phone-frame.png';
import screenHome from '../../../assets/projects/rebound/screen-home.png';
import screenSignIn from '../../../assets/projects/rebound/screen-sign-in.png';

const frameSizes = '(min-width: 48rem) 280px, 46vw';
---

<div
  class="rb-intro"
  role="img"
  aria-label="Rebound: Come Back Stronger. Two phones show the app's sign-in screen and its home screen, with a 10-day streak and Stage 1 Early Recovery."
>
  <div class="rb-intro__phone rb-intro__phone--home">
    <Image src={screenHome} alt="" class="rb-intro__screen" loading="eager" />
    <Image src={frame} alt="" class="rb-intro__frame" widths={[600, 900]} sizes={frameSizes} loading="eager" />
  </div>
  <div class="rb-intro__phone rb-intro__phone--sign-in">
    <Image src={screenSignIn} alt="" class="rb-intro__screen" loading="eager" />
    <Image src={frame} alt="" class="rb-intro__frame" widths={[600, 900]} sizes={frameSizes} loading="eager" />
  </div>
  <Image src={wordmark} alt="" class="rb-intro__wordmark" />
</div>

<style>
  /* Phones: taller stage, wordmark on top and the phones overlapping below it */
  .rb-intro {
    --mark-x: 8%;      --mark-y: 6%;   --mark-w: 84%;
    --home-x: 44%;     --home-y: 29%;  --phone-w: 46%;
    --sign-in-x: 10%;  --sign-in-y: 40%;

    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    background: linear-gradient(to bottom, var(--case-accent-1, #9e86fe) 36%, var(--case-bg, #000));
  }

  .rb-intro > :global(*) {
    position: absolute;
  }

  .rb-intro :global(.rb-intro__wordmark) {
    left: var(--mark-x);
    top: var(--mark-y);
    width: var(--mark-w);
    height: auto;
  }

  /* A phone is the frame's size (1400×2700); the screen sits inside its bezel */
  .rb-intro__phone {
    width: var(--phone-w);
    aspect-ratio: 1400 / 2700;
  }

  .rb-intro__phone--home    { left: var(--home-x);    top: var(--home-y); }
  .rb-intro__phone--sign-in { left: var(--sign-in-x); top: var(--sign-in-y); }

  .rb-intro__phone :global(img) {
    position: absolute;
    max-width: none;
  }

  .rb-intro__phone :global(.rb-intro__frame) {
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 0;
  }

  /* The screens are inset from the frame's edges, as in Figma */
  .rb-intro__phone :global(.rb-intro__screen) {
    border-radius: 8.7% / 4.1%;
    object-fit: cover;
    object-position: top;
  }

  .rb-intro__phone--home :global(.rb-intro__screen) {
    left: 6.55%;
    top: 3%;
    width: 87%;
    height: 94.7%;
  }

  .rb-intro__phone--sign-in :global(.rb-intro__screen) {
    left: 7.43%;
    top: 2.53%;
    width: 85.15%;
    height: 95.5%;
  }

  /* Desktop: the slide's own 16:9 layout (1920×1080 coordinates as percentages) */
  @media (min-width: 48rem) {
    .rb-intro {
      --mark-x: 46.8%;    --mark-y: 40.6%;  --mark-w: 42.9%;
      --home-x: 21.13%;   --home-y: 9.39%;  --phone-w: 23.36%;
      --sign-in-x: 9.45%; --sign-in-y: 30.44%;

      aspect-ratio: 16 / 9;
    }
  }
</style>
