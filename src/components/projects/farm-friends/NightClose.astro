---
// The closing section, set in the game's night sky (the last two sky stops), where every climb
// ends: a full-width band with stars and the owl, a lead question and numbered lessons.
import PixelSprite from './PixelSprite.astro';
import { owl } from './flyers';

interface Lesson {
  title: string;
  text: string;
}

interface Props {
  title: string;
  id?: string;
  lead: string;
  lessons: Lesson[];
}

const { title, id, lead, lessons } = Astro.props;

// A fixed scatter of stars (x, y in %), every fifth one a "plus" star like the game's
const stars = [
  [4, 12], [9, 58], [14, 30], [18, 82], [23, 8], [27, 46], [33, 70], [38, 18], [44, 90], [49, 36],
  [55, 6], [59, 62], [64, 24], [69, 84], [73, 44], [78, 14], [83, 66], [88, 32], [93, 76], [97, 20],
];
---

<section class="ffc-night full-bleed" id={id}>
  {stars.map(([x, y], i) => <span class="ffc-night__star" data-big={i % 5 === 0 ? '' : undefined} style={`left: ${x}%; top: ${y}%`} aria-hidden="true" />)}
  <span class="ffc-night__owl" aria-hidden="true"><PixelSprite {...owl} label="" /></span>
  <div class="ffc-night__inner">
    <h2 class="ffc-night__title">{title}</h2>
    <p class="ffc-night__lead">{lead}</p>
    <ol class="ffc-night__lessons" role="list">
      {
        lessons.map(({ title, text }, i) => (
          <li class="ffc-night__lesson">
            <span class="ffc-night__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ffc-night {
    position: relative;
    margin-block: var(--space-8) 0;
    padding-block: var(--space-9);
    overflow: hidden;
    background: linear-gradient(#1d2559, #091040);
    color: #c9cde8;
  }

  .ffc-night__star {
    position: absolute;
    width: 3px;
    height: 3px;
    background: #ffffff;
    opacity: 0.7;
  }

  .ffc-night__star[data-big] {
    box-shadow: -3px 0 #fff, 3px 0 #fff, 0 -3px #fff, 0 3px #fff;
    opacity: 1;
  }

  .ffc-night__owl {
    position: absolute;
    top: var(--space-7);
    right: 8%;
    width: clamp(3.5rem, 7vw, 6rem);
  }

  .ffc-night__inner {
    position: relative;
    width: 100%;
    max-width: calc(var(--container-max) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .ffc-night__title {
    font-size: var(--text-h1);
    font-weight: var(--weight-medium);
    color: #ffffff;
  }

  .ffc-night__lead {
    max-width: var(--container-narrow);
    margin-top: var(--space-5);
    font-size: var(--text-h2);
    font-weight: var(--weight-medium);
    line-height: var(--leading-heading);
    color: #fde9aa;
  }

  .ffc-night__lessons {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-7);
    padding: 0;
    list-style: none;
  }

  .ffc-night__lesson {
    padding: var(--space-6);
    border: var(--border-width) solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius-md);
    /* Opaque enough that stars don't show through the text */
    background: rgb(29 37 89 / 0.92);
  }

  .ffc-night__num {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: #fde9aa;
  }

  .ffc-night__lesson h3 {
    margin-top: var(--space-2);
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    color: #ffffff;
  }

  .ffc-night__lesson p {
    margin-top: var(--space-2);
  }

  @media (min-width: 48rem) {
    .ffc-night__lessons {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
  }
</style>
