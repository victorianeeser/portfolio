---
// The three deliverables, each on a card the size of the Figma cards (371×316):
// 01 the design system (print colors, type, buttons and cloud platforms, built as
// elements), 02 the working prototype's title screen rebuilt from its pixel art, and
// 03 a photo of the collector's token. Sizes inside the cards use cqw, so each card
// scales as one piece.
import { Image } from 'astro:assets';
import base from '../../../assets/projects/farm-friends-climb/deliverables/base.png';
import logo from '../../../assets/projects/farm-friends-climb/deliverables/logo.png';
import cloudNormal from '../../../assets/projects/farm-friends-climb/deliverables/cloud-normal.png';
import cloudSpringBig from '../../../assets/projects/farm-friends-climb/deliverables/cloud-spring.png';
import piglet from '../../../assets/projects/farm-friends-climb/deliverables/piglet.png';
import cow from '../../../assets/projects/farm-friends-climb/deliverables/cow.png';
import bee from '../../../assets/projects/farm-friends-climb/deliverables/bee.png';
import bird from '../../../assets/projects/farm-friends-climb/deliverables/bird.png';
import token from '../../../assets/projects/farm-friends-climb/deliverables/token.jpg';
import cloudStatic from '../../../assets/projects/farm-friends-climb/clouds/static.png';
import cloudMoving from '../../../assets/projects/farm-friends-climb/clouds/moving.png';
import cloudSpring from '../../../assets/projects/farm-friends-climb/clouds/spring.png';
import cloudBreakable from '../../../assets/projects/farm-friends-climb/clouds/breakable.png';
import cloudGust from '../../../assets/projects/farm-friends-climb/clouds/gust.png';

// Print colors from the game's character list (js/characters.js)
const prints = ['#7798b6', '#621a28', '#db9c9d', '#979766', '#9a9a7b', '#458b90'];
const clouds = [
  { src: cloudStatic, label: 'Static' },
  { src: cloudMoving, label: 'Moving' },
  { src: cloudSpring, label: 'Spring' },
  { src: cloudBreakable, label: 'Breaks' },
  { src: cloudGust, label: 'Gust' },
];
---

<ol class="ffc-deliver case-wide" role="list">
  <li class="ffc-deliver__item">
    <div class="ffc-deliver__art ffc-deliver__art--system" aria-hidden="true">
      <div class="ffc-system">
        <p class="ffc-system__label">Prints</p>
        <div class="ffc-system__chips">
          {prints.map((c) => <span style={`background: ${c}`} />)}
        </div>

        <div class="ffc-system__split">
          <div>
            <p class="ffc-system__label">Type</p>
            <p class="ffc-system__type">Aa <span>Climb</span></p>
          </div>
          <div>
            <p class="ffc-system__label">Buttons</p>
            <div class="ffc-system__buttons">
              <span class="ffc-system__button">Play Now</span>
              <span class="ffc-system__button ffc-system__button--ghost">Characters</span>
            </div>
          </div>
        </div>

        <p class="ffc-system__label">Cloud platforms</p>
        <div class="ffc-system__clouds">
          {
            clouds.map(({ src, label }) => (
              <span>
                <Image src={src} alt="" width={160} />
                {label}
              </span>
            ))
          }
        </div>
      </div>
    </div>
    <span class="ffc-deliver__num">01</span>
    <h3 class="ffc-deliver__title">Figma design system</h3>
    <p class="ffc-deliver__text">The foundation every screen and character is built on.</p>
  </li>

  <li class="ffc-deliver__item">
    <div class="ffc-deliver__art ffc-deliver__art--proto" aria-hidden="true">
      <Image src={base} alt="" class="ffc-proto__base" widths={[600, 1000]} sizes="(min-width: 48rem) 420px, 100vw" />
      <Image src={cloudSpringBig} alt="" class="ffc-proto__cloud-spring" width={240} />
      <Image src={cloudNormal} alt="" class="ffc-proto__cloud-normal" width={240} />
      <Image src={bird} alt="" class="ffc-proto__bird" width={120} />
      <Image src={bee} alt="" class="ffc-proto__bee" width={80} />
      <div class="ffc-proto__title">
        <Image src={logo} alt="" width={600} />
        <span>Climb</span>
      </div>
      <span class="ffc-proto__play">Play Now</span>
      <Image src={piglet} alt="" class="ffc-proto__piglet" width={160} />
      <Image src={cow} alt="" class="ffc-proto__cow" width={200} />
    </div>
    <span class="ffc-deliver__num">02</span>
    <h3 class="ffc-deliver__title">Working prototype</h3>
    <p class="ffc-deliver__text">The proof of concept: a tap-to-play build.</p>
  </li>

  <li class="ffc-deliver__item">
    <div class="ffc-deliver__art ffc-deliver__art--token">
      <Image
        src={token}
        alt="The collector's token: a needlepoint canvas of the cow on pastel stripes, surrounded by thread bobbins, scissors and Dairy Boy pins"
        widths={[600, 1000, 1600]}
        sizes="(min-width: 48rem) 560px, 140vw"
      />
    </div>
    <span class="ffc-deliver__num">03</span>
    <h3 class="ffc-deliver__title">Collector's token</h3>
    <p class="ffc-deliver__text">The tangible extension that makes the idea feel real.</p>
  </li>
</ol>

<style>
  .ffc-deliver {
    display: grid;
    gap: var(--space-6) var(--grid-gap);
    margin-block: var(--space-6) var(--space-8);
    padding: 0;
    list-style: none;
  }

  /* Every card is the Figma card's shape (371×316) */
  .ffc-deliver__art {
    position: relative;
    container-type: inline-size;
    overflow: hidden;
    aspect-ratio: 371 / 316;
    border-radius: var(--radius-md);
  }

  .ffc-deliver__art :global(img) {
    position: absolute;
    max-width: none;
    height: auto;
    border-radius: 0;
    image-rendering: pixelated;
  }

  .ffc-deliver__num {
    display: block;
    margin-top: var(--space-4);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--case-heading-1);
  }

  .ffc-deliver__title {
    margin-top: var(--space-1);
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
  }

  .ffc-deliver__text {
    margin-top: var(--space-1);
    color: var(--color-text-secondary);
  }

  /* 01: the design system on the home screen's cream */
  .ffc-deliver__art--system {
    display: grid;
    place-items: center;
    background: #faf7f2;
  }

  .ffc-system {
    display: grid;
    gap: 2.2cqw;
    width: 86%;
    color: #3a2a20;
  }

  .ffc-system__label {
    font-size: 2.8cqw;
    font-weight: var(--weight-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8b2a3a;
  }

  .ffc-system__chips {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.8cqw;
    margin-bottom: 1.5cqw;
  }

  .ffc-system__chips span {
    aspect-ratio: 1;
    border-radius: 1.5cqw;
  }

  .ffc-system__split {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 4cqw;
    margin-bottom: 1.5cqw;
  }

  .ffc-system__split > div {
    display: grid;
    gap: 2.2cqw;
    align-content: start;
  }

  .ffc-system__type {
    font-size: 9cqw;
    font-weight: var(--weight-medium);
    line-height: 1;
  }

  .ffc-system__type span {
    font-size: 3.6cqw;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8b2a3a;
  }

  .ffc-system__buttons {
    display: grid;
    gap: 1.6cqw;
  }

  .ffc-system__button {
    padding: 1.6cqw 3cqw;
    border-radius: 999px;
    background: #7d2839;
    font-size: 3cqw;
    font-weight: var(--weight-medium);
    text-align: center;
    color: #fff;
  }

  .ffc-system__button--ghost {
    background: none;
    box-shadow: inset 0 0 0 0.4cqw #7d2839;
    color: #7d2839;
  }

  .ffc-system__clouds {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2cqw;
  }

  .ffc-system__clouds span {
    display: grid;
    justify-items: center;
    gap: 1cqw;
    font-size: 2.6cqw;
    color: #6b5a4e;
  }

  /* Same-size box for every cloud, so the labels line up */
  .ffc-system__clouds :global(img) {
    position: static;
    width: 100%;
    height: 9cqw;
    object-fit: contain;
    object-position: bottom;
  }

  /* 02: the prototype's title screen (positions are the Figma card's, as percentages) */
  .ffc-deliver__art--proto {
    background: linear-gradient(#fdc98a, #fde2a3);
  }

  .ffc-deliver__art--proto :global(.ffc-proto__base) { left: -2.3%; bottom: 0; width: 108.7%; }
  .ffc-deliver__art--proto :global(.ffc-proto__cloud-spring) { left: -3.9%; top: 33.6%; width: 21.6%; }
  .ffc-deliver__art--proto :global(.ffc-proto__cloud-normal) { left: 84.5%; top: 7.6%; width: 20.7%; }
  .ffc-deliver__art--proto :global(.ffc-proto__bird) { left: 7.5%; top: 9.4%; width: 9.1%; }
  .ffc-deliver__art--proto :global(.ffc-proto__bee) { left: 81.4%; top: 34.6%; width: 6.3%; transform: scaleX(-1); }
  .ffc-deliver__art--proto :global(.ffc-proto__piglet) { left: 37.3%; top: 81.4%; width: 13.6%; }
  .ffc-deliver__art--proto :global(.ffc-proto__cow) { left: 67.9%; top: 75.1%; width: 18.4%; transform: scaleX(-1); }

  .ffc-proto__title {
    position: absolute;
    top: 10.4%;
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.2cqw;
    width: 59.8%;
    transform: translateX(-50%);
  }

  .ffc-proto__title :global(img) {
    position: static;
    width: 100%;
    image-rendering: auto;
  }

  .ffc-proto__title span {
    font-size: 4cqw;
    font-weight: var(--weight-medium);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8b2a3a;
  }

  .ffc-proto__play {
    position: absolute;
    left: 57.1%;
    top: 48.1%;
    display: grid;
    place-items: center;
    width: 31%;
    height: 11.8%;
    border-radius: 999px;
    background: #7d2839;
    box-shadow: 0 0.2cqw 0.3cqw rgb(0 0 0 / 0.1);
    font-size: 2.9cqw;
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    color: #fff;
  }

  /* 03: the token photo, cropped as in Figma */
  .ffc-deliver__art--token {
    background: linear-gradient(#fdc98a, #fde2a3);
  }

  .ffc-deliver__art--token :global(img) {
    left: -16.7%;
    top: -6.9%;
    width: 140.5%;
    image-rendering: auto;
  }

  @media (min-width: 48rem) {
    .ffc-deliver {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
