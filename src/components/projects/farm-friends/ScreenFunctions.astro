---
// Screen-by-screen table: what each game screen does for the campaign.
interface Row {
  screen: string;
  job: string;
}

interface Props {
  rows: Row[];
  caption?: string;
}

const { rows, caption = 'What each screen does for the campaign' } = Astro.props;
---

<table class="screens case-wide">
  <caption class="visually-hidden">{caption}</caption>
  <thead>
    <tr>
      <th scope="col">Screen</th>
      <th scope="col">Marketing function</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map(({ screen, job }) => (
        <tr>
          <th scope="row">{screen}</th>
          <td>{job}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .screens {
    width: 100%;
    margin-block: var(--space-6);
    border-collapse: collapse;
    text-align: left;
  }

  .screens thead th {
    padding-bottom: var(--space-3);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .screens tbody th,
  .screens td {
    padding-block: var(--space-4);
    border-top: var(--border);
    vertical-align: top;
  }

  .screens tbody th {
    width: 40%;
    padding-right: var(--space-4);
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    color: var(--case-heading-1);
  }

  .screens td {
    color: var(--color-text);
  }
</style>
