---
// "Meet the Characters": the six Farm Friends as their character-select tiles.
import CharacterTile from './CharacterTile.astro';

const names = ['Cow', 'Mallard Duck', 'Rooster', 'Barn Mouse', 'Sheep', 'Piglet'];
---

<ul class="ffc-tiles case-wide" role="list">
  {names.map((name) => <CharacterTile name={name} as="li" />)}
</ul>

<style>
  .ffc-tiles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin-block: var(--space-6);
    padding: 0;
    list-style: none;
  }

  /* Close to the Figma tile size (204px): three across on tablets, all six in a row on desktop */
  @media (min-width: 40rem) {
    .ffc-tiles {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .ffc-tiles {
      grid-template-columns: repeat(6, 1fr);
    }
  }
</style>
