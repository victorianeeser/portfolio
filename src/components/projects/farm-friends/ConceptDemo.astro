---
// The Concept: the copy beside the game's character select screen on a phone (the Figma
// mockup). The copy sits level with the bottom of the phone. It goes in the default slot.
import { Image } from 'astro:assets';
import phone from '../../../assets/projects/farm-friends-climb/concept-phone.png';
---

<div class="ffc-concept case-wide">
  <div class="ffc-concept__text"><slot /></div>

  <figure class="ffc-phone">
    <Image
      src={phone}
      alt="Farm Friends Climb on a phone: the character select screen with the Sheep in its Scottish Plaid print, a Tap to Play button, Leaderboard and My Stats, over a pixel-art farm"
      widths={[500, 1036]}
      sizes="(min-width: 48rem) 470px, 100vw"
    />
  </figure>
</div>

<style>
  .ffc-concept {
    display: grid;
    gap: var(--space-7);
    align-items: end;
    margin-block: var(--space-4) var(--space-7);
  }

  .ffc-concept__text > :global(* + *) {
    margin-top: var(--space-4);
  }

  .ffc-phone {
    justify-self: center;
    /* The image includes the phone's soft shadow, so it's wider than the phone itself */
    width: min(100%, 29rem);
    margin: 0;
  }

  .ffc-phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }

  @media (min-width: 48rem) {
    /* Same size as the case study's other body paragraphs */
    .ffc-concept__text {
      font-size: var(--text-h3);
    }

    .ffc-concept {
      grid-template-columns: 3fr 2fr;
      gap: var(--space-8);
    }

    /* Level with the phone's bottom edge, not the shadow under it */
    .ffc-concept__text {
      padding-bottom: var(--space-7);
    }
  }
</style>
