---
// The leaderboard strategy: the copy, one big callout, and the prize tiers as a podium
// (1st in the middle and tallest, 2nd–3rd on the left, 4th–10th on the right). On phones
// the podium becomes a ranked list, 1st first. The copy goes in the default slot.
import SectionTitle from '../../case/SectionTitle.astro';

interface Tier {
  place: string;
  label: string;
  prizes: string[];
}

interface Props {
  id?: string;
  title: string;
  callout: string;
  /** Tiers in rank order: 1st, then 2nd–3rd, then 4th–10th */
  tiers: [Tier, Tier, Tier];
}

const { id, title, callout, tiers } = Astro.props;
---

<section class="ffc-board case-wide" id={id}>
  <div class="ffc-board__intro">
    <div class="ffc-board__text">
      <SectionTitle>{title}</SectionTitle>
      <slot />
    </div>
    <p class="ffc-board__callout">{callout}</p>
  </div>

  <ol class="ffc-board__podium" role="list" aria-label="Prize tiers">
    {
      tiers.map(({ place, label, prizes }, i) => (
        <li class="ffc-board__step" data-rank={i + 1}>
          <div class="ffc-board__prize">
            <p class="ffc-board__label">{label}</p>
            <ul>{prizes.map((p) => <li>{p}</li>)}</ul>
          </div>
          <div class="ffc-board__block">
            <span class="ffc-board__place">{place}</span>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .ffc-board {
    margin-block: var(--space-6) var(--space-8);
  }

  .ffc-board__intro {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .ffc-board__text > :global(* + *) {
    margin-top: var(--space-4);
  }

  .ffc-board__text > :global(.section-title + *) {
    margin-top: var(--space-5);
  }

  /* The callout: the strategy in one line, Merlot on butter */
  .ffc-board__callout {
    padding: var(--space-6);
    border-left: 4px solid #621a28;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: #fdf1d2;
    font-size: var(--text-h2);
    font-weight: var(--weight-medium);
    line-height: var(--leading-heading);
    color: #621a28;
  }

  /* Podium */
  .ffc-board__podium {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .ffc-board__step {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-4);
    align-items: center;
  }

  .ffc-board__step .ffc-board__block { order: -1; }

  .ffc-board__block {
    display: grid;
    place-items: center;
    height: 5rem;
    border-radius: var(--radius-md);
    background: #f3e7e9;
  }

  .ffc-board__place {
    font-size: var(--text-h2);
    font-weight: var(--weight-medium);
    color: #621a28;
  }

  .ffc-board__step[data-rank='1'] .ffc-board__block {
    background: #621a28;
  }

  .ffc-board__step[data-rank='1'] .ffc-board__place {
    color: #fde9aa;
  }

  .ffc-board__label {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .ffc-board__prize ul {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-1);
    padding: 0;
    list-style: none;
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  /* Wide screens: a real podium, prizes sitting on top of each step */
  @media (min-width: 48rem) {
    .ffc-board__intro {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-8);
    }

    /* The steps stand on one baseline */
    .ffc-board__podium {
      grid-template-columns: repeat(3, 1fr);
      align-items: end;
      gap: var(--space-3);
      border-bottom: 3px solid #621a28;
    }

    .ffc-board__step {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      text-align: center;
    }

    .ffc-board__step .ffc-board__block { order: 0; }

    /* 2nd–3rd left, 1st center, 4th–10th right */
    .ffc-board__step[data-rank='1'] { grid-column: 2; grid-row: 1; }
    .ffc-board__step[data-rank='2'] { grid-column: 1; grid-row: 1; }
    .ffc-board__step[data-rank='3'] { grid-column: 3; grid-row: 1; }

    .ffc-board__step[data-rank='1'] .ffc-board__block { height: 12rem; }
    .ffc-board__step[data-rank='2'] .ffc-board__block { height: 8rem; }
    .ffc-board__step[data-rank='3'] .ffc-board__block { height: 5rem; }

    .ffc-board__block {
      border-radius: var(--radius-md) var(--radius-md) 0 0;
    }

    .ffc-board__place {
      font-size: var(--text-h1);
    }
  }
</style>
