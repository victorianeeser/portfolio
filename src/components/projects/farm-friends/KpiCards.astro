---
// Marketing KPIs as cards in the style of the game's "My Stats" screen: white cards with
// a small-caps label on the game's grey, each with an icon in one of the print colors.
import Icon from '../../case/Icon.astro';

const kpis = [
  { label: 'Email signups', text: 'Collected during the campaign window', icon: 'mail', tint: '#fce1e0', ink: '#8b2a3a' },
  { label: 'Replays per user', text: 'Whether the climb keeps people coming back', icon: 'replay', tint: '#dbe8f0', ink: '#3f6a8f' },
  { label: 'Social shares', text: 'Scores posted and shared', icon: 'share', tint: '#e3ecd9', ink: '#5a6b3a' },
  { label: 'Session time', text: 'Average session or dwell time', icon: 'clock', tint: '#fde9aa', ink: '#7a5a12' },
] as const;
---

<ul class="ffc-kpis case-wide" role="list">
  {
    kpis.map(({ label, text, icon, tint, ink }) => (
      <li class="ffc-kpi">
        <span class="ffc-kpi__icon" style={`background: ${tint}; color: ${ink}`}>
          <Icon name={icon} />
        </span>
        <h3 class="ffc-kpi__label">{label}</h3>
        <p class="ffc-kpi__text">{text}</p>
      </li>
    ))
  }
</ul>

<style>
  .ffc-kpis {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-block: var(--space-6);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: #f2f2f2;
    list-style: none;
  }

  .ffc-kpi {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: #ffffff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.1), 0 1px 2px rgb(0 0 0 / 0.06);
  }

  .ffc-kpi__icon {
    display: grid;
    place-items: center;
    width: var(--icon-tile);
    height: var(--icon-tile);
    margin-bottom: var(--space-2);
    border-radius: var(--radius-sm);
  }

  .ffc-kpi__label {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: #6b4a3a;
  }

  .ffc-kpi__text {
    font-size: var(--text-h3);
    line-height: var(--leading-heading);
    color: #3a2a20;
  }

  @media (min-width: 48rem) {
    .ffc-kpis {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-4);
      padding: var(--space-5);
    }
  }
</style>
