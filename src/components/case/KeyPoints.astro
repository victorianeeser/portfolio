---
// A row of short titled points with an accent rule on top, e.g. the ideas behind a logo.
interface Point {
  title: string;
  text: string;
}

interface Props {
  items: Point[];
  accent?: 1 | 2 | 3;
}

const { items, accent = 1 } = Astro.props;
---

<ul class="points case-wide" data-accent={accent} role="list">
  {
    items.map(({ title, text }) => (
      <li class="point">
        <h4>{title}</h4>
        <p>{text}</p>
      </li>
    ))
  }
</ul>

<style>
  .points {
    --accent: var(--case-heading-1, var(--color-text));
    display: grid;
    gap: var(--space-6) var(--grid-gap);
    margin-block: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .points[data-accent='2'] { --accent: var(--case-heading-2, var(--color-text)); }
  .points[data-accent='3'] { --accent: var(--case-heading-3, var(--color-text)); }

  .point {
    padding-top: var(--space-4);
    border-top: calc(var(--border-width) * 3) solid var(--accent);
  }

  .point h4 {
    margin-bottom: var(--space-2);
    font-family: var(--case-font, var(--font-sans));
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  @media (min-width: 48rem) {
    .points {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
