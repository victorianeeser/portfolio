---
// Editorial photo grid: the first photo is a large feature (two columns by two rows),
// the next two sit beside it, and the rest run three across. Photos are cropped to fill
// their cells. Items without `src` show a labeled placeholder.
import ImageSlot from '../ImageSlot.astro';
import type { ImageMetadata } from 'astro';

interface Photo {
  label: string; // shown on the placeholder until the photo is added
  src?: ImageMetadata;
  alt?: string;
  /** Which part of the photo stays in frame, e.g. "50% 30%" */
  focus?: string;
}

interface Props {
  items: Photo[];
}

const { items } = Astro.props;
---

<div class="gallery case-wide">
  {
    items.map(({ label, src, alt, focus }, i) => (
      <ImageSlot
        label={label}
        src={src}
        alt={alt}
        focus={focus}
        ratio="portrait"
        sizes={i === 0 ? '(min-width: 48rem) 66vw, 100vw' : '(min-width: 48rem) 33vw, 50vw'}
      />
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-block: var(--space-6);
  }

  /* Phones: the feature photo runs full width, and so does a leftover last photo
     (an even total leaves an odd number after the feature) */
  .gallery > :global(:first-child),
  .gallery > :global(:last-child:nth-child(even)) {
    grid-column: 1 / -1;
  }

  /* Every photo fills its cell */
  .gallery > :global(.slot) {
    height: 100%;
  }

  .gallery > :global(.slot) :global(img),
  .gallery > :global(.slot) :global(.image-slot) {
    height: 100%;
  }

  @media (min-width: 48rem) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }

    /* Desktop: feature spans two columns and two rows; its shape follows the grid */
    .gallery > :global(:last-child:nth-child(even)) {
      grid-column: auto;
    }

    .gallery > :global(:first-child) {
      grid-column: span 2;
      grid-row: span 2;
    }

    .gallery > :global(:first-child) :global(img),
    .gallery > :global(:first-child) :global(.image-slot) {
      aspect-ratio: auto;
    }
  }
</style>
