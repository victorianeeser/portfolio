---
// Editorial photo grid: the first photo is a large feature, the next two sit beside it,
// and the rest run in rows below: four across when they divide into fours, otherwise
// three. Photos are cropped to fill their cells. Items without `src` show a placeholder.
import ImageSlot from '../ImageSlot.astro';
import type { ImageMetadata } from 'astro';

interface Photo {
  label: string; // shown on the placeholder until the photo is added
  src?: ImageMetadata;
  alt?: string;
  /** Which part of the photo stays in frame, e.g. "50% 30%" */
  focus?: string;
}

interface Props {
  items: Photo[];
}

const { items } = Astro.props;
// Photos after the feature and the two beside it
const rest = Math.max(0, items.length - 3);
const restPerRow = rest > 0 && rest % 4 === 0 ? 4 : 3;
---

<div class="gallery case-wide" style={`--rest-span: ${12 / restPerRow}`}>
  {
    items.map(({ label, src, alt, focus }, i) => (
      <ImageSlot
        label={label}
        src={src}
        alt={alt}
        focus={focus}
        ratio="portrait"
        sizes={i === 0 ? '(min-width: 48rem) 66vw, 100vw' : '(min-width: 48rem) 33vw, 50vw'}
      />
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-block: var(--space-6);
  }

  /* Phones: the feature photo runs full width, and so does a leftover last photo
     (an even total leaves an odd number after the feature) */
  .gallery > :global(:first-child),
  .gallery > :global(:last-child:nth-child(even)) {
    grid-column: 1 / -1;
  }

  /* Every photo fills its cell */
  .gallery > :global(.slot) {
    height: 100%;
  }

  .gallery > :global(.slot) :global(img),
  .gallery > :global(.slot) :global(.image-slot) {
    height: 100%;
  }

  @media (min-width: 48rem) {
    /* 12-column grid: feature takes 8 columns and two rows, the next two take 4 each,
       and the rest take 3 (four across) or 4 (three across) */
    .gallery {
      grid-template-columns: repeat(12, 1fr);
      gap: var(--space-4);
    }

    .gallery > :global(*),
    .gallery > :global(:last-child:nth-child(even)) {
      grid-column: span var(--rest-span);
    }

    .gallery > :global(:nth-child(2)),
    .gallery > :global(:nth-child(3)) {
      grid-column: span 4;
    }

    .gallery > :global(:first-child) {
      grid-column: span 8;
      grid-row: span 2;
    }

    .gallery > :global(:first-child) :global(img),
    .gallery > :global(:first-child) :global(.image-slot) {
      aspect-ratio: auto;
    }
  }
</style>
