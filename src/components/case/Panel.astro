---
// A full-width, project-themed band inside a case study, e.g. "Research: The Shift in Performance Tracking".
// Colors and font come from the project's theme (see src/styles/themes/).
interface Props {
  eyebrow?: string;
  title: string;
  /** Part of the title to color with the accent, e.g. "Performance" */
  highlight?: string;
  accent?: 1 | 2 | 3;
  intro?: string;
  /** 'light' swaps to the theme's light palette, to alternate with dark panels */
  tone?: 'dark' | 'light';
  /** Heading level: 2 when the panel starts a new case study section, else 3 */
  level?: 2 | 3;
  /** Anchor id, e.g. for a section nav link */
  id?: string;
}

const { eyebrow, title, highlight, accent = 1, intro, tone = 'dark', level = 3, id } = Astro.props;
const Heading = `h${level}` as const;

const [before, after] = highlight && title.includes(highlight) ? title.split(highlight) : [title, undefined];
---

<section class="panel" id={id} data-accent={accent} data-tone={tone}>
  <div class="panel__inner">
    <header class="panel__head">
      {eyebrow && <p class="panel__eyebrow">{eyebrow}</p>}
      <Heading class="panel__title">
        {before}{after !== undefined && <span class="panel__highlight">{highlight}</span>}{after}
      </Heading>
      {intro && <p class="panel__intro">{intro}</p>}
    </header>
    <slot />
  </div>
</section>

<style>
  .panel {
    --accent: var(--case-accent-1-text, var(--color-text));
    grid-column: full;
    margin-block: var(--space-8);
    padding-block: var(--space-8);
    background: var(--case-glow, none), var(--case-bg, var(--color-text));
    color: var(--case-muted, var(--color-bg));
    font-family: var(--case-font, var(--font-sans));
  }

  /* Back-to-back panels join into one dark band, split by a hairline */
  .panel + .panel {
    margin-top: calc(var(--space-8) * -1);
    border-top: var(--border-width) solid var(--case-border);
  }

  .panel[data-accent='2'] { --accent: var(--case-accent-2-text); }
  .panel[data-accent='3'] { --accent: var(--case-accent-3-text); }

  .panel__inner {
    width: 100%;
    max-width: calc(var(--container-max) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .panel__head {
    max-width: var(--container-narrow);
  }

  .panel__eyebrow {
    margin-bottom: var(--space-2);
    font-size: var(--text-small);
    letter-spacing: var(--tracking-caps);
    color: var(--case-muted);
  }

  .panel__title {
    font-family: inherit;
    font-size: var(--text-h1);
    font-weight: var(--weight-medium);
    color: var(--case-text, var(--color-bg));
  }

  /* Titles are large text, so a theme may use a brighter accent here than in body text */
  .panel__highlight {
    color: var(--case-title-accent, var(--accent));
  }

  .panel__intro {
    margin-top: var(--space-4);
  }

  /* Space between blocks placed inside a panel */
  .panel__inner > :global(* + *) {
    margin-top: var(--space-7);
  }

  .panel :global(.case-grid-2) {
    display: grid;
    gap: var(--grid-gap);
  }

  @media (min-width: 48rem) {
    .panel :global(.case-grid-2) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .panel :global(h4 + img) {
    margin-top: var(--space-4);
  }

  /* Shared styles for content placed inside any panel */
  .panel :global(h4) {
    font-family: inherit;
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    color: var(--case-text);
  }

  .panel :global(img) {
    border-radius: var(--radius-md);
  }
</style>
