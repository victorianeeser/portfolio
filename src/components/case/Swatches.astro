---
// Color palette swatches with name and hex value.
interface Props {
  colors: { name: string; hex: string }[];
}

const { colors } = Astro.props;
---

<ul class="swatches" role="list">
  {
    colors.map(({ name, hex }) => (
      <li class="swatch">
        <span class="swatch__chip" style={`background: ${hex}`} />
        <span class="swatch__name">{name}</span>
        <code class="swatch__hex">{hex}</code>
      </li>
    ))
  }
</ul>

<style>
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--swatch-min), 1fr));
    gap: var(--space-5) var(--space-4);
    padding: 0;
    list-style: none;
  }

  .swatch {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-small);
  }

  .swatch__chip {
    aspect-ratio: var(--ratio-card);
    margin-bottom: var(--space-2);
    border: var(--border-width) solid var(--case-border);
    border-radius: var(--radius-md);
  }

  .swatch__name {
    color: var(--case-text);
  }

  .swatch__hex {
    font-family: inherit;
    text-transform: uppercase;
  }
</style>
