---
// Competitive analysis: one row per competitor with strengths, weaknesses and takeaways.
// Start a list item with "!" to highlight it in the row's accent color.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Competitor {
  name: string;
  type: string; // e.g. "Direct competitor"
  image?: ImageMetadata;
  accent?: 1 | 2 | 3;
  strengths: string[];
  weaknesses: string[];
  takeaways: string[];
}

interface Props {
  items: Competitor[];
}

const { items } = Astro.props;

const columns = [
  { key: 'strengths', label: 'Strengths' },
  { key: 'weaknesses', label: 'Weaknesses' },
  { key: 'takeaways', label: 'Key takeaways' },
] as const;
---

<ul class="competitors" role="list">
  {
    items.map((c) => (
      <li class="competitor" data-accent={c.accent ?? 1}>
        <div class="competitor__id">
          {c.image && <Image src={c.image} alt="" class="competitor__image" height={120} />}
          <div>
            <h4>{c.name}</h4>
            <p class="competitor__type">{c.type}</p>
          </div>
        </div>
        {columns.map(({ key, label }) => (
          <div class="competitor__col">
            <p class="competitor__label">{label}</p>
            <ul role="list">
              {c[key].map((item) => {
                const highlighted = item.startsWith('!');
                return <li class:list={[highlighted && 'is-highlighted']}>{highlighted ? item.slice(1) : item}</li>;
              })}
            </ul>
          </div>
        ))}
      </li>
    ))
  }
</ul>

<style>
  .competitors {
    display: flex;
    flex-direction: column;
    padding: 0;
    list-style: none;
  }

  .competitor {
    --accent: var(--case-accent-1);
    --accent-text: var(--case-accent-1-text);
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: var(--border-width) solid var(--case-border);
  }

  .competitor[data-accent='2'] { --accent: var(--case-accent-2); --accent-text: var(--case-accent-2-text); }
  .competitor[data-accent='3'] { --accent: var(--case-accent-3); --accent-text: var(--case-accent-3-text); }

  /* Phones: product image beside the name */
  .competitor__id {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }

  /* :global because <Image> doesn't receive this component's scoped style marker */
  .competitor__id :global(.competitor__image) {
    flex: none;
    width: var(--space-9);
    height: var(--space-8);
    object-fit: contain;
  }

  .competitor__type {
    font-size: var(--text-small);
    color: var(--accent-text);
  }

  /* Phones: label on the left, bullets on the right */
  .competitor__col {
    display: grid;
    grid-template-columns: var(--competitor-label-width) 1fr;
    gap: var(--space-3);
    font-size: var(--text-small);
  }

  .competitor__label {
    font-weight: var(--weight-medium);
    color: var(--case-text);
  }

  .competitor__col ul {
    padding-left: var(--space-4);
    list-style: disc;
  }

  .competitor__col li::marker {
    color: var(--accent);
  }

  .competitor__col li + li {
    margin-top: var(--space-1);
  }

  .is-highlighted {
    color: var(--accent-text);
    font-weight: var(--weight-medium);
  }

  /* Desktop: one row per competitor, one column per category */
  @media (min-width: 48rem) {
    .competitor {
      grid-template-columns: 1.2fr repeat(3, 1fr);
      gap: var(--grid-gap);
      align-items: start;
    }

    .competitor__id {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 0;
    }

    .competitor__id :global(.competitor__image) {
      width: auto;
      height: var(--space-9);
    }

    .competitor__col {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
