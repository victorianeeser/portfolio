---
// Competitive analysis as side-by-side cards: what each app does well and where it could
// improve. Stacked on phones, one column per app on wide screens.
interface App {
  name: string;
  type?: string; // e.g. "Direct competitor"
  features: string[];
  improve: string[];
}

interface Props {
  items: App[];
  featuresLabel?: string;
  improveLabel?: string;
}

const { items, featuresLabel = 'Features', improveLabel = 'Areas to improve' } = Astro.props;
---

<ul class="compare case-wide" role="list">
  {
    items.map(({ name, type, features, improve }) => (
      <li class="compare__card">
        <header class="compare__head">
          <h3 class="compare__name">{name}</h3>
          {type && <p class="compare__type">{type}</p>}
        </header>
        <div class="compare__group">
          <h4 class="compare__label">{featuresLabel}</h4>
          <ul class="compare__list" data-kind="features">
            {features.map((f) => <li>{f}</li>)}
          </ul>
        </div>
        <div class="compare__group">
          <h4 class="compare__label">{improveLabel}</h4>
          <ul class="compare__list" data-kind="improve">
            {improve.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .compare {
    display: grid;
    gap: var(--grid-gap);
    margin-block: var(--space-6);
    padding: 0;
    list-style: none;
    font-family: var(--case-font, var(--font-sans));
  }

  .compare__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .compare__head {
    padding-bottom: var(--space-4);
    border-bottom: calc(var(--border-width) * 3) solid var(--case-heading-1, var(--color-text));
  }

  .compare__name {
    font-size: var(--text-h2);
    font-weight: var(--weight-medium);
    color: var(--case-heading-1, var(--color-text));
  }

  .compare__type {
    margin-top: var(--space-1);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .compare__label {
    margin-bottom: var(--space-3);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .compare__list {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .compare__list li {
    position: relative;
    padding-left: var(--space-5);
  }

  /* Check marks for features, arrows for improvements */
  .compare__list li::before {
    position: absolute;
    left: 0;
    color: var(--case-heading-1, var(--color-text));
  }

  .compare__list[data-kind='features'] li::before { content: '✓'; }
  .compare__list[data-kind='improve'] li::before { content: '→'; }

  @media (min-width: 64rem) {
    .compare {
      grid-template-columns: repeat(var(--compare-count, 3), 1fr);
    }
  }
</style>
