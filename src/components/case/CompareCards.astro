---
// Competitive analysis as a horizontal row of cards people can swipe or scroll, with
// previous/next buttons (same pattern as SwipeCards). Each card shows the app's icon and
// name, then its features beside its areas to improve. Keep lists the same length so the
// cards match. Without an icon, the card shows the app's initial on a tile.
// tone="dark" sets the cards in the theme's dark surface color (e.g. Rebound's dark purple).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface App {
  name: string;
  type?: string; // e.g. "Direct competitor"
  icon?: ImageMetadata;
  features: string[];
  improve: string[];
}

interface Props {
  label?: string;
  items: App[];
  featuresLabel?: string;
  improveLabel?: string;
  tone?: 'light' | 'dark';
  /** Keep the label for screen readers only, e.g. when a section title already names the row */
  hideLabel?: boolean;
}

const { label = 'Competitors', items, featuresLabel = 'Features', improveLabel = 'Areas to improve', tone = 'light', hideLabel = false } = Astro.props;
const id = `compare-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section class="compare case-wide" data-cards={tone} data-label={hideLabel ? 'hidden' : undefined} aria-labelledby={`${id}-title`}>
  <div class="compare__top">
    <h3 id={`${id}-title`} class:list={['compare__label', hideLabel && 'visually-hidden']}>{label}</h3>
    <div class="compare__controls" hidden>
      <button type="button" class="compare__btn" data-dir="-1" aria-controls={id} aria-label="Previous app">←</button>
      <button type="button" class="compare__btn" data-dir="1" aria-controls={id} aria-label="Next app">→</button>
    </div>
  </div>

  <ul id={id} class="compare__track" role="list" tabindex="0" aria-label={`${label}, scrollable`}>
    {
      items.map(({ name, type, icon, features, improve }) => (
        <li class="compare__card" data-tone={tone === 'dark' ? 'dark' : undefined}>
          <header class="compare__head">
            {icon ? (
              <Image src={icon} alt="" class="compare__icon" width={112} height={112} />
            ) : (
              <span class="compare__icon compare__icon--blank" aria-hidden="true">{name[0]}</span>
            )}
            <div>
              <h4 class="compare__name">{name}</h4>
              {type && <p class="compare__type">{type}</p>}
            </div>
          </header>
          <div class="compare__cols">
            <div>
              <h5 class="compare__group">{featuresLabel}</h5>
              <ul class="compare__list" data-kind="features">
                {features.map((f) => <li>{f}</li>)}
              </ul>
            </div>
            <div>
              <h5 class="compare__group">{improveLabel}</h5>
              <ul class="compare__list" data-kind="improve">
                {improve.map((f) => <li>{f}</li>)}
              </ul>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.compare').forEach((compare) => {
    const track = compare.querySelector<HTMLElement>('.compare__track')!;
    const controls = compare.querySelector<HTMLElement>('.compare__controls')!;
    const [prev, next] = compare.querySelectorAll<HTMLButtonElement>('.compare__btn');
    controls.hidden = false;

    const step = () => {
      const card = track.querySelector<HTMLElement>('.compare__card');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };
    const sync = () => {
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };

    [prev, next].forEach((btn) =>
      btn.addEventListener('click', () => {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        track.scrollBy({ left: Number(btn.dataset.dir) * step(), behavior: reduce ? 'auto' : 'smooth' });
      }),
    );
    track.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    sync();
  });
</script>

<style>
  .compare {
    --card-width: 88%;
    margin-block: var(--space-6);
    font-family: var(--case-font, var(--font-sans));
  }

  .compare__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  /* With the label hidden, the cards sit right under the section title and the
     buttons move below them, on the right */
  .compare[data-label='hidden'] {
    display: flex;
    flex-direction: column;
  }

  :global(.case-body) > .compare[data-label='hidden'] {
    margin-top: var(--space-5);
  }

  .compare[data-label='hidden'] .compare__top {
    order: 1;
    justify-content: flex-end;
    margin: var(--space-3) 0 0;
  }

  .compare__label {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text);
  }

  .compare__controls {
    display: flex;
    gap: var(--space-2);
  }

  .compare__controls[hidden] {
    display: none;
  }

  .compare__btn {
    width: var(--tap-target);
    height: var(--tap-target);
    border: var(--border-width) solid var(--color-text);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-body);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .compare__btn:hover:not(:disabled) {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .compare__btn:disabled {
    border-color: var(--color-border);
    color: var(--color-text-tertiary);
    cursor: default;
  }

  /* Cards share one row height, so they always match */
  .compare__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--card-width);
    gap: var(--space-4);
    margin: 0;
    padding: 0 0 var(--space-3);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    list-style: none;
  }

  .compare__track:focus-visible {
    outline-offset: var(--space-1);
  }

  .compare__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    scroll-snap-align: start;
  }

  .compare__head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    border-bottom: var(--border);
  }

  .compare :global(.compare__icon) {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 22%;
    object-fit: cover;
  }

  .compare__icon--blank {
    display: grid;
    place-items: center;
    background: var(--color-surface);
    font-size: var(--text-h2);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
  }

  .compare__name {
    font-size: var(--text-h2);
    font-weight: var(--weight-medium);
    line-height: var(--leading-heading);
    color: var(--case-heading-1, var(--color-text));
  }

  .compare__type {
    margin-top: var(--space-1);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .compare__cols {
    display: grid;
    gap: var(--space-5);
  }

  .compare__group {
    margin-bottom: var(--space-3);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .compare__list {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .compare__list li {
    position: relative;
    padding-left: var(--space-5);
  }

  /* Check marks for features, arrows for improvements */
  .compare__list li::before {
    position: absolute;
    left: 0;
    color: var(--case-heading-1, var(--color-text));
  }

  .compare__list[data-kind='features'] li::before { content: '✓'; }
  .compare__list[data-kind='improve'] li::before { content: '→'; }

  /* Dark cards: the theme's surface color, light text and bright accent markers */
  .compare[data-cards='dark'] .compare__card {
    border-color: var(--case-surface);
    background: var(--case-surface);
    color: var(--case-muted);
  }

  .compare[data-cards='dark'] .compare__head {
    border-bottom-color: var(--case-border);
  }

  .compare[data-cards='dark'] .compare__name {
    color: var(--case-text);
  }

  .compare[data-cards='dark'] :is(.compare__type, .compare__group) {
    color: var(--case-subtle, var(--case-muted));
  }

  .compare[data-cards='dark'] .compare__list li::before {
    color: var(--case-accent-1-text);
  }

  .compare[data-cards='dark'] .compare__icon--blank {
    background: var(--case-accent-1);
    color: var(--case-surface);
  }

  /* Wide screens: about one and a half cards in view, so the row reads as scrollable,
     with features and improvements side by side */
  @media (min-width: 48rem) {
    .compare {
      --card-width: 62%;
    }

    .compare__cols {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }
</style>
