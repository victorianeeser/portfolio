---
// A row of app screens with a caption under each. Four across on desktop.
// On phones it becomes a swipeable row that runs to the screen edge, with a swipe hint,
// previous/next buttons, a position counter and dots. Without JavaScript it's still
// a plain swipeable row; the script only adds the controls.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Screen {
  image: ImageMetadata;
  alt: string;
  title: string; // bold lead-in, e.g. "Focus Mode"
  text: string;
}

interface Props {
  items: Screen[];
  label?: string;
}

const { items, label = 'App screens' } = Astro.props;
---

<div class="phones" style={`--phone-count: ${items.length}`}>
  <div class="phones__controls" hidden>
    <p class="phones__hint" aria-hidden="true">Swipe to see all {items.length} screens →</p>
    <div class="phones__nav">
      <span class="phones__count" aria-live="polite">1 / {items.length}</span>
      <button type="button" class="phones__btn" data-dir="-1" aria-label="Previous screen">←</button>
      <button type="button" class="phones__btn" data-dir="1" aria-label="Next screen">→</button>
    </div>
  </div>

  <ul class="phones__track" role="list" tabindex="0" aria-label={`${label}, scrollable`}>
    {
      items.map(({ image, alt, title, text }) => (
        <li class="phones__item">
          <Image src={image} alt={alt} class="phones__image" widths={[400, image.width]} sizes="(min-width: 48rem) 280px, 60vw" />
          <p class="phones__caption">
            <strong>{title}</strong> {text}
          </p>
        </li>
      ))
    }
  </ul>

  <div class="phones__dots" hidden>
    {items.map(({ title }, i) => <button type="button" class="phones__dot" data-index={i} aria-label={`Show ${title}`} />)}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.phones').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.phones__track')!;
    const items = [...track.querySelectorAll<HTMLElement>('.phones__item')];
    const count = root.querySelector<HTMLElement>('.phones__count')!;
    const [prev, next] = root.querySelectorAll<HTMLButtonElement>('.phones__btn');
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.phones__dot')];
    root.querySelectorAll<HTMLElement>('[hidden]').forEach((el) => (el.hidden = false));

    const behavior = () => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth');
    const current = () => {
      // The last screen can't reach the left edge, so treat "scrolled to the end" as the last one
      if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 2) return items.length - 1;
      const start = track.getBoundingClientRect().left + parseFloat(getComputedStyle(track).scrollPaddingLeft || '0');
      let best = 0;
      items.forEach((item, i) => {
        if (Math.abs(item.getBoundingClientRect().left - start) < Math.abs(items[best].getBoundingClientRect().left - start)) best = i;
      });
      return best;
    };
    const goTo = (i: number) => {
      const target = items[Math.max(0, Math.min(items.length - 1, i))];
      track.scrollTo({ left: target.offsetLeft - items[0].offsetLeft, behavior: behavior() });
    };
    const sync = () => {
      const i = current();
      count.textContent = `${i + 1} / ${items.length}`;
      prev.disabled = i === 0;
      next.disabled = i === items.length - 1;
      dots.forEach((dot, d) => dot.setAttribute('aria-current', String(d === i)));
    };

    prev.addEventListener('click', () => goTo(current() - 1));
    next.addEventListener('click', () => goTo(current() + 1));
    dots.forEach((dot) => dot.addEventListener('click', () => goTo(Number(dot.dataset.index))));
    track.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    sync();
  });
</script>

<style>
  /* ---------- Phones: swipeable row ---------- */
  .phones__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .phones__controls[hidden],
  .phones__dots[hidden] {
    display: none;
  }

  .phones__hint {
    font-size: var(--text-small);
    color: var(--case-muted);
  }

  .phones__nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .phones__count {
    min-width: 3ch;
    margin-right: var(--space-1);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
    color: var(--case-text);
  }

  .phones__btn {
    width: var(--tap-target);
    height: var(--tap-target);
    border: var(--border-width) solid var(--case-text);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--case-text);
    cursor: pointer;
  }

  .phones__btn:disabled {
    border-color: var(--case-border);
    color: var(--case-muted);
    cursor: default;
  }

  /* The row runs to the screen edge so the next screen visibly peeks in */
  .phones__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 62%;
    gap: var(--space-4);
    margin-inline: calc(var(--gutter) * -1);
    padding: 0 var(--gutter) var(--space-3);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    list-style: none;
  }

  .phones__track::-webkit-scrollbar {
    display: none;
  }

  .phones__track:focus-visible {
    outline-offset: calc(var(--space-1) * -1);
  }

  .phones__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    scroll-snap-align: start;
  }

  /* :global because <Image> doesn't receive this component's scoped style marker */
  .phones :global(.phones__image) {
    width: 100%;
    height: auto;
    border-radius: 0;
  }

  .phones__caption {
    font-size: var(--text-small);
    color: var(--case-text);
  }

  /* Small bold text on black needs the lighter blue for contrast */
  .phones__caption strong {
    color: var(--case-accent-1-text);
    font-weight: var(--weight-bold);
  }

  .phones__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-1);
    margin-top: var(--space-3);
  }

  /* Each dot sits in a full-size tap target */
  .phones__dot {
    display: grid;
    place-items: center;
    width: var(--space-6);
    height: var(--space-6);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .phones__dot::before {
    content: '';
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--case-muted);
    transition:
      width var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .phones__dot[aria-current='true']::before {
    width: var(--space-5);
    background: var(--case-accent-1);
  }

  /* ---------- Desktop: all screens in one row, no controls ---------- */
  @media (min-width: 48rem) {
    /* Two classes deep so this wins over the script un-hiding them */
    .phones .phones__controls,
    .phones .phones__dots {
      display: none;
    }

    .phones__track {
      grid-auto-flow: row;
      grid-template-columns: repeat(var(--phone-count), minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: var(--space-5);
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }

    .phones__item {
      gap: var(--space-5);
    }

    .phones__caption {
      font-size: var(--text-h3);
    }

    /* Large enough here for the true accent color */
    .phones__caption strong {
      color: var(--case-title-accent, var(--case-accent-1-text));
    }
  }
</style>
