---
// A row of app screens with a caption under each. Four across on desktop;
// a swipeable row on phones.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Screen {
  image: ImageMetadata;
  alt: string;
  title: string; // bold lead-in, e.g. "Focus Mode"
  text: string;
}

interface Props {
  items: Screen[];
}

const { items } = Astro.props;
---

<ul class="phones" role="list" tabindex="0" aria-label="App screens, scrollable">
  {
    items.map(({ image, alt, title, text }) => (
      <li class="phones__item">
        <Image src={image} alt={alt} class="phones__image" widths={[400, image.width]} sizes="(min-width: 48rem) 280px, 65vw" />
        <p class="phones__caption">
          <strong>{title}</strong> {text}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .phones {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 65%;
    gap: var(--space-5);
    padding: 0 0 var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    list-style: none;
  }

  .phones:focus-visible {
    outline-offset: var(--space-1);
  }

  .phones__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    scroll-snap-align: start;
  }

  /* :global because <Image> doesn't receive this component's scoped style marker */
  .phones :global(.phones__image) {
    width: 100%;
    height: auto;
    border-radius: 0;
  }

  .phones__caption {
    color: var(--case-text);
  }

  /* Small bold text on black needs the lighter blue for contrast */
  .phones__caption strong {
    color: var(--case-accent-1-text);
    font-weight: var(--weight-bold);
  }

  /* Desktop: all screens in one row; captions are large enough for the true accent */
  @media (min-width: 48rem) {
    .phones {
      grid-auto-flow: row;
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      grid-auto-columns: auto;
      overflow: visible;
    }

    .phones__caption {
      font-size: var(--text-h3);
    }

    .phones__caption strong {
      color: var(--case-title-accent, var(--case-accent-1-text));
    }
  }
</style>
