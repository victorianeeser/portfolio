---
// Product colorways: a swipeable stage with one render per color, and a list of color
// options to jump between them. Swiping or scrolling the stage updates the selected
// option. Without JavaScript the stage is still a plain swipeable row.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Colorway {
  name: string;
  description: string;
  swatch: string; // any CSS background, e.g. a gradient
  image: ImageMetadata;
  alt: string;
}

interface Props {
  items: Colorway[];
  label?: string;
}

const { items, label = 'Colorways' } = Astro.props;
const id = `colors-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<div class="picker case-wide">
  <ul id={id} class="picker__stage" role="list" tabindex="0" aria-label={`${label}, scrollable`}>
    {
      items.map(({ name, image, alt }) => (
        <li class="picker__slide" aria-label={name}>
          <Image src={image} alt={alt} class="picker__image" widths={[480, 800, image.width]} sizes="(min-width: 48rem) 55vw, 90vw" />
        </li>
      ))
    }
  </ul>

  <div class="picker__options" role="group" aria-label={`Choose a ${label.toLowerCase().replace(/s$/, '')}`}>
    <p class="picker__hint">Swipe the earbuds or pick a color</p>
    {
      items.map(({ name, description, swatch }, i) => (
        <button type="button" class="picker__option" data-index={i} aria-controls={id} aria-pressed={i === 0 ? 'true' : 'false'}>
          <span class="picker__swatch" style={`background: ${swatch}`} aria-hidden="true" />
          <span class="picker__text">
            <span class="picker__name">{name}</span>
            <span class="picker__desc">{description}</span>
          </span>
        </button>
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.picker').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('.picker__stage')!;
    const slides = [...stage.querySelectorAll<HTMLElement>('.picker__slide')];
    const options = [...root.querySelectorAll<HTMLButtonElement>('.picker__option')];

    const select = (i: number) => options.forEach((o, n) => o.setAttribute('aria-pressed', String(n === i)));
    const current = () => Math.round(stage.scrollLeft / stage.clientWidth);

    options.forEach((option) =>
      option.addEventListener('click', () => {
        const i = Number(option.dataset.index);
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        stage.scrollTo({ left: slides[i].offsetLeft - slides[0].offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
        select(i);
      }),
    );
    stage.addEventListener('scroll', () => select(current()), { passive: true });
  });
</script>

<style>
  .picker {
    display: grid;
    gap: var(--space-5);
    margin-block: var(--space-6);
    font-family: var(--case-font, var(--font-sans));
  }

  /* One colorway per "page"; swipe or scroll between them */
  .picker__stage {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    padding: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    list-style: none;
  }

  .picker__stage::-webkit-scrollbar {
    display: none;
  }

  .picker__slide {
    display: grid;
    place-items: center;
    padding: var(--space-6);
    scroll-snap-align: start;
  }

  /* :global because <Image> doesn't receive this component's scoped style marker */
  .picker :global(.picker__image) {
    width: 100%;
    max-width: var(--picker-image-max);
    height: auto;
  }

  .picker__options {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .picker__hint {
    margin-bottom: var(--space-2);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .picker__option {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    text-align: left;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .picker__option:hover {
    border-color: var(--color-text-tertiary);
  }

  .picker__option[aria-pressed='true'] {
    border-color: var(--case-accent-1, var(--color-text));
    box-shadow: inset 0 0 0 var(--border-width) var(--case-accent-1, var(--color-text));
  }

  .picker__swatch {
    flex: none;
    width: var(--space-7);
    height: var(--space-7);
    border: calc(var(--border-width) * 2) solid var(--color-border);
    border-radius: var(--radius-pill);
  }

  .picker__text {
    display: flex;
    flex-direction: column;
  }

  .picker__name {
    font-weight: var(--weight-medium);
  }

  .picker__desc {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  /* Desktop: stage on the left, color list on the right */
  @media (min-width: 48rem) {
    .picker {
      grid-template-columns: 1.6fr 1fr;
      align-items: center;
      gap: var(--space-7);
    }

    .picker__slide {
      padding: var(--space-8);
    }
  }
</style>
