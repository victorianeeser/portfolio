---
// A browser window with a scrollable viewport, for showing a full-length web page design.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  url?: string; // shown in the address bar
}

const { image, alt, url = 'example.com' } = Astro.props;
---

<figure class="browser case-wide">
  <figcaption class="browser__hint">Scroll inside the window to explore the full page ↓</figcaption>
  <div class="browser__window">
    <div class="browser__bar" aria-hidden="true">
      <span class="browser__dots"><span></span><span></span><span></span></span>
      <span class="browser__url">{url}</span>
    </div>
    <div class="browser__viewport" tabindex="0" role="region" aria-label={`${url} landing page, scrollable`}>
      <Image src={image} alt={alt} class="browser__page" widths={[700, image.width]} sizes="(min-width: 75rem) 1100px, 100vw" />
    </div>
  </div>
</figure>

<style>
  .browser {
    margin-block: var(--space-6);
  }

  .browser__hint {
    margin-bottom: var(--space-3);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .browser__window {
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    box-shadow: var(--shadow-lg);
  }

  .browser__bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--border);
    background: var(--color-surface);
  }

  .browser__dots {
    display: flex;
    gap: var(--space-2);
  }

  .browser__dots span {
    width: var(--space-3);
    height: var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-border);
  }

  .browser__url {
    flex: 1;
    max-width: var(--browser-url-max);
    margin-inline: auto;
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    font-size: var(--text-small);
    text-align: center;
    color: var(--color-text-secondary);
  }

  /* The page scrolls inside the window; scrolling past its ends doesn't move the case study */
  .browser__viewport {
    height: min(70svh, 50rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .browser__viewport:focus-visible {
    outline-offset: calc(var(--focus-ring-offset) * -1);
  }

  /* :global because <Image> doesn't receive this component's scoped style marker */
  .browser :global(.browser__page) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }
</style>
