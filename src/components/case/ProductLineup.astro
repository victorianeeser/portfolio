---
// A lineup of product cut-outs (transparent PNGs) on grey cards, each with its name.
// A product can have several views (e.g. front and back): swipe the card or tap the dots
// to switch. Views without `src` show a labeled placeholder.
import ImageSlot from '../ImageSlot.astro';
import type { ImageMetadata } from 'astro';

interface View {
  label: string; // e.g. "Front"
  src?: ImageMetadata;
  alt?: string;
}

interface Product {
  name: string;
  note?: string; // optional short detail, e.g. color
  views: View[];
  /** Image already has its own background (e.g. a presentation graphic): fill the card */
  fill?: boolean;
}

interface Props {
  label?: string;
  items: Product[];
}

const { label = 'The pieces', items } = Astro.props;
---

<section class="lineup case-wide" aria-label={label}>
  <p class="lineup__label">{label}</p>
  <ul class="lineup__grid" role="list">
    {
      items.map(({ name, note, views, fill }) => (
        <li class="lineup__item" data-fill={fill ? '' : undefined}>
          <ul class="lineup__views" role="list" tabindex="0" aria-label={`${name}${note ? ` (${note})` : ''} views`}>
            {views.map((view) => (
              <li class="lineup__view" aria-label={view.label}>
                <ImageSlot
                  label={`${name}${note ? ` ${note}` : ''}: ${view.label.toLowerCase()} (PNG)`}
                  src={view.src}
                  alt={view.alt ?? `${name}, ${view.label.toLowerCase()}`}
                  ratio="square"
                  sizes="(min-width: 48rem) 20vw, 30vw"
                />
              </li>
            ))}
          </ul>
          {views.length > 1 && (
            <div class="lineup__dots">
              {views.map((view, i) => (
                <button type="button" class="lineup__dot" data-index={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Show ${view.label.toLowerCase()} of ${name}`} />
              ))}
              <span class="lineup__view-label" aria-hidden="true">{views[0].label}</span>
            </div>
          )}
          <p class="lineup__name">{name}</p>
          {note && <p class="lineup__note">{note}</p>}
        </li>
      ))
    }
  </ul>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.lineup__item').forEach((item) => {
    const track = item.querySelector<HTMLElement>('.lineup__views')!;
    const views = [...track.querySelectorAll<HTMLElement>('.lineup__view')];
    const dots = [...item.querySelectorAll<HTMLButtonElement>('.lineup__dot')];
    const label = item.querySelector<HTMLElement>('.lineup__view-label');
    if (dots.length < 2) return;

    const select = (i: number) => {
      dots.forEach((d, n) => d.setAttribute('aria-pressed', String(n === i)));
      if (label) label.textContent = views[i].getAttribute('aria-label');
    };
    dots.forEach((dot) =>
      dot.addEventListener('click', () => {
        const i = Number(dot.dataset.index);
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        track.scrollTo({ left: i * track.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
        select(i);
      }),
    );
    track.addEventListener('scroll', () => select(Math.round(track.scrollLeft / track.clientWidth)), { passive: true });
  });
</script>

<style>
  .lineup {
    margin-block: var(--space-7);
    font-family: var(--case-font, var(--font-sans));
  }

  .lineup__label {
    margin-bottom: var(--space-4);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--case-heading-1, var(--color-text));
  }

  /* Phones: three small cards across */
  .lineup__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5) var(--space-3);
    padding: 0;
    list-style: none;
  }

  /* One view per "page"; swipe between them. Cut-outs sit on grey, fully visible. */
  .lineup__views {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    padding: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    list-style: none;
  }

  .lineup__views::-webkit-scrollbar {
    display: none;
  }

  .lineup__views:focus-visible {
    outline-offset: var(--space-1);
  }

  .lineup__view {
    padding: var(--space-3);
    scroll-snap-align: start;
  }

  .lineup__view :global(img) {
    object-fit: contain;
    background: transparent;
  }

  /* Graphics with their own background fill the card edge to edge */
  .lineup__item[data-fill] .lineup__view {
    padding: 0;
  }

  .lineup__item[data-fill] .lineup__view :global(img) {
    object-fit: cover;
  }

  /* Inside a dark panel: light text and dots so they stay readable */
  :global(.panel[data-tone='dark']) .lineup__label {
    color: var(--case-accent-1-text);
  }

  :global(.panel[data-tone='dark']) .lineup__name {
    color: var(--case-text);
  }

  :global(.panel[data-tone='dark']) .lineup__note,
  :global(.panel[data-tone='dark']) .lineup__view-label {
    color: var(--case-muted);
  }

  :global(.panel[data-tone='dark']) .lineup__dot::before {
    background: var(--case-border);
  }

  :global(.panel[data-tone='dark']) .lineup__dot[aria-pressed='true']::before {
    background: var(--case-text);
  }

  /* Dots sit in full-size tap targets; the current view's name sits beside them */
  .lineup__dots {
    display: flex;
    align-items: center;
    margin-top: var(--space-1);
  }

  .lineup__dot {
    display: grid;
    place-items: center;
    width: var(--space-5);
    height: var(--space-6);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .lineup__dot::before {
    content: '';
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-border);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .lineup__dot[aria-pressed='true']::before {
    background: var(--case-heading-1, var(--color-text));
  }

  .lineup__view-label {
    margin-left: var(--space-1);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .lineup__name {
    margin-top: var(--space-2);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .lineup__note {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  @media (min-width: 48rem) {
    .lineup__grid {
      grid-template-columns: repeat(auto-fit, minmax(var(--lineup-item-min), 1fr));
      gap: var(--space-6) var(--space-4);
    }

    .lineup__view {
      padding: var(--space-5);
    }

    .lineup__item[data-fill] .lineup__view {
      padding: 0;
    }

    .lineup__name {
      font-size: var(--text-body);
    }
  }
</style>
