---
// Renders a Figma export or video once set; until then, a labeled gray placeholder.
// `src` can be a path in /public (string) or an imported image (src/assets or a
// content-collection image), which Astro resizes and compresses automatically.
// `video` is a Vimeo or YouTube link, embedded as a player.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  label: string;
  src?: string | ImageMetadata;
  video?: string;
  alt?: string;
  type?: 'image' | 'video';
  /** 'auto' keeps the image's own proportions (no cropping) */
  ratio?: 'hero' | 'card' | 'thumb' | 'portrait' | 'square' | 'auto';
  caption?: string;
  eager?: boolean;
  /** Which part of the image stays in frame when cropped, e.g. "50% 30%" */
  focus?: string;
  /** Rendered width hint for responsive images */
  sizes?: string;
}

const {
  label,
  src,
  video,
  alt = '',
  type = video ? 'video' : 'image',
  ratio = 'hero',
  caption,
  eager = false,
  focus = 'center',
  sizes = '(min-width: 48rem) 50vw, 100vw',
} = Astro.props;

// Turn a Vimeo/YouTube page URL into its embeddable player URL
function embedUrl(url: string) {
  const vimeo = url.match(/vimeo\.com\/(?:video\/)?(\d+)/);
  if (vimeo) return `https://player.vimeo.com/video/${vimeo[1]}?dnt=1`;
  const youtube = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([\w-]{11})/);
  if (youtube) return `https://www.youtube-nocookie.com/embed/${youtube[1]}`;
  return undefined;
}
const embed = video ? embedUrl(video) : undefined;
// Only generate sizes up to the image's own width (never upscale)
function responsiveWidths(max: number) {
  const widths = [400, 800, 1200, 1600, 2400].filter((w) => w < max);
  return [...widths, max];
}
// Embedded players need a fixed shape; fall back to 16:9
const slotRatio = embed && ratio === 'auto' ? 'hero' : ratio;
---

<figure class="slot" data-ratio={slotRatio} style={`--slot-focus: ${focus}`}>
  {
    embed ? (
      <iframe
        src={embed}
        title={alt || label}
        loading={eager ? 'eager' : 'lazy'}
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen
      />
    ) : video ? (
      <video src={video} controls muted playsinline preload="metadata" aria-label={alt || label} />
    ) : !src ? (
      <div class="image-slot" role="img" aria-label={`Placeholder: ${label}`}>
        {type === 'video' ? 'Figma video' : 'Figma'}: {label}
      </div>
    ) : typeof src === 'object' ? (
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        widths={responsiveWidths(src.width)}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
      />
    ) : (
      <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    )
  }
  {caption && <figcaption class="meta">{caption}</figcaption>}
</figure>

<style>
  .slot {
    --slot-ratio: var(--ratio-hero);
  }
  .slot[data-ratio='card'] { --slot-ratio: var(--ratio-card); }
  .slot[data-ratio='thumb'] { --slot-ratio: var(--ratio-thumb); }
  .slot[data-ratio='portrait'] { --slot-ratio: var(--ratio-portrait); }
  .slot[data-ratio='square'] { --slot-ratio: var(--ratio-square); }
  .slot[data-ratio='auto'] { --slot-ratio: auto; }

  /* :global so it also reaches the <img> that <Picture> renders */
  .image-slot,
  .slot :global(img),
  video,
  iframe {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--slot-ratio);
    border: 0;
    border-radius: var(--radius-md);
    object-fit: cover;
    object-position: var(--slot-focus);
    background: var(--color-surface);
  }

  /* Placeholders still need a shape when the ratio is 'auto' */
  .slot[data-ratio='auto'] .image-slot {
    aspect-ratio: var(--ratio-hero);
  }

  figcaption {
    margin-top: var(--space-3);
  }
</style>
