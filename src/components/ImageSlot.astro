---
// Renders a Figma export once `src` is set; until then, a labeled gray placeholder.
// `src` can be a path in /public (string) or an imported file from src/assets,
// which Astro resizes and compresses automatically.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  label: string;
  src?: string | ImageMetadata;
  alt?: string;
  type?: 'image' | 'video';
  ratio?: 'hero' | 'card' | 'portrait' | 'square';
  caption?: string;
  eager?: boolean;
  /** Which part of the image stays in frame when cropped, e.g. "50% 30%" */
  focus?: string;
  /** Rendered width hint for responsive images */
  sizes?: string;
}

const {
  label,
  src,
  alt = '',
  type = 'image',
  ratio = 'hero',
  caption,
  eager = false,
  focus = 'center',
  sizes = '(min-width: 48rem) 50vw, 100vw',
} = Astro.props;
---

<figure class="slot" data-ratio={ratio} style={`--slot-focus: ${focus}`}>
  {
    !src ? (
      <div class="image-slot" role="img" aria-label={`Placeholder: ${label}`}>
        {type === 'video' ? 'Figma video' : 'Figma'}: {label}
      </div>
    ) : typeof src === 'object' ? (
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[400, 800, 1200]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
      />
    ) : type === 'video' ? (
      <video src={src} controls muted playsinline preload="metadata" aria-label={alt || label} />
    ) : (
      <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    )
  }
  {caption && <figcaption class="meta">{caption}</figcaption>}
</figure>

<style>
  .slot {
    --slot-ratio: var(--ratio-hero);
  }
  .slot[data-ratio='card'] { --slot-ratio: var(--ratio-card); }
  .slot[data-ratio='portrait'] { --slot-ratio: var(--ratio-portrait); }
  .slot[data-ratio='square'] { --slot-ratio: var(--ratio-square); }

  /* :global so it also reaches the <img> that <Picture> renders */
  .image-slot,
  .slot :global(img),
  video {
    width: 100%;
    aspect-ratio: var(--slot-ratio);
    border-radius: var(--radius-md);
    object-fit: cover;
    object-position: var(--slot-focus);
    background: var(--color-surface);
  }

  figcaption {
    margin-top: var(--space-3);
  }
</style>
