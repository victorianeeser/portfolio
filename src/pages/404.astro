---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="container page-head not-found">
    <p class="eyebrow">404</p>
    <h1 class="display">This page doesn't exist.</h1>
    <p class="lead">It may have moved, or the link might be mistyped.</p>
    <div class="not-found__actions">
      <a href="/" class="button">Back home</a>
      <a href="/work/" class="button button--outline">See my work</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-10);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-4);
  }
</style>
