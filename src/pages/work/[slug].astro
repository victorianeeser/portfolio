---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import { getProjects } from '../../lib/projects';
import '../../styles/themes/impact.css';
import '../../styles/themes/courtsync.css';
import '../../styles/themes/wellness.css';
import '../../styles/themes/farm-friends.css';
import '../../styles/themes/rebound.css';
import '../../styles/themes/oura.css';
import CourtSyncHero from '../../components/projects/courtsync/CourtSyncHero.astro';
import ReboundHero from '../../components/projects/rebound/ReboundHero.astro';
import OuraHero from '../../components/projects/oura/OuraHero.astro';

// Projects whose hero is built as a custom section rather than a single image
const heroComponents = { courtsync: CourtSyncHero, rebound: ReboundHero, oura: OuraHero };

export async function getStaticPaths() {
  // Coming-soon projects show as cards only, with no page yet
  const projects = (await getProjects()).filter((p) => !p.data.comingSoon);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    // Loop back to the first project after the last
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { title, summary, role, timeline, tools, team, type, tags, hero, heroComponent, gallery, links, theme } = project.data;
const HeroComponent = heroComponent ? heroComponents[heroComponent] : undefined;
const { Content } = await render(project);

const meta = [
  { label: 'Role', value: role },
  { label: 'Timeline', value: timeline },
  { label: 'Tools', value: tools.join(', ') },
  { label: 'Team', value: team },
  ...(type ? [{ label: 'Type', value: type }] : []),
];
---

<BaseLayout title={title} description={summary}>
  <article class={theme ? `theme-${theme}` : undefined}>
    <header class="container case-head">
      <div class="page-head">
        <ul class="tag-list" aria-label="Tags">
          {tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
        <h1>{title}</h1>
        <p class="lead">{summary}</p>
      </div>

      {
        HeroComponent ? (
          <HeroComponent />
        ) : (
          hero && <ImageSlot {...hero} ratio={hero.ratio ?? 'hero'} sizes="(min-width: 75rem) 1200px, 100vw" eager />
        )
      }

      <dl class="meta-row">
        {
          meta.map(({ label, value }) => (
            <div>
              <dt class="eyebrow">{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>

      {
        links.length > 0 && (
          <ul class="case-links" role="list">
            {links.map(({ label, url }, i) => (
              <li>
                <a href={url} class:list={['button', i > 0 && 'button--outline']} rel="noopener" target="_blank">
                  {label} ↗<span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose case-body">
      <Content />
    </div>

    {
      gallery.length > 0 && (
        <section class="container section" aria-labelledby="gallery-title">
          <h2 id="gallery-title" class="eyebrow gallery-title">Gallery</h2>
          <div class="grid grid--2">
            {gallery.map((item) => (
              <ImageSlot {...item} ratio={item.ratio ?? 'card'} />
            ))}
          </div>
        </section>
      )
    }

    {
      next.id !== project.id && (
        <nav class="container next" aria-label="Next project">
          <a href={`/work/${next.id}/`} class="next__link">
            <span class="eyebrow">Next project</span>
            <span class="next__title">{next.data.title} →</span>
          </a>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .case-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .case-head .page-head {
    padding-bottom: 0;
  }

  .meta-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-block: var(--border);
  }

  .meta-row dt {
    margin-bottom: var(--space-1);
  }

  .meta-row dd {
    margin: 0;
    font-size: var(--text-small);
  }

  /* Text sits in a reading column aligned to the page's left edge (with the title,
     photos and panels), leaving open space on the right; images break out to the full
     container width. On phones the text column simply takes the full width. */
  .case-body {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [wide-start content-start] min(var(--container-prose), 100% - var(--gutter) * 2)
      [content-end] minmax(0, calc(var(--container-max) - var(--container-prose)))
      [wide-end] minmax(var(--gutter), 1fr)
      [full-end];
    padding-block: var(--space-6) var(--space-8);
  }

  /* Larger body text on desktop keeps the wider lines comfortable to read */
  @media (min-width: 48rem) {
    /* Plain paragraphs and lists only; labels like "Collection 01" keep their size */
    .case-body > :global(p:not([class])),
    .case-body > :global(ul:not([class])),
    .case-body > :global(ol:not([class])) {
      font-size: var(--text-h3);
    }
  }

  .case-body > :global(*) {
    grid-column: content;
  }

  /* Project-themed panels run edge to edge */
  .case-body > :global(.panel),
  .case-body > :global(.stack-slides),
  .case-body > :global(.full-bleed),
  .case-body > :global(.section-nav) {
    grid-column: full;
  }

  /* Back-to-back full-width bands touch, with no white strip between them.
     Each band has --space-8 of vertical margin; this cancels the pair between them. */
  .case-body > :global(:is(.panel, .stack-slides, .full-bleed) + :is(.panel, .stack-slides, .full-bleed)) {
    margin-top: calc(var(--space-8) * -1);
  }

  /* Whatever follows a panel uses only the panel's spacing, so the gap matches the one above it */
  .case-body > :global(.panel + *) {
    margin-top: 0;
  }

  /* A panel that ends the case study sits flush with the section below */
  .case-body:has(> :global(:is(.panel, .full-bleed):last-child)) {
    padding-bottom: 0;
  }

  .case-body > :global(:is(.panel, .full-bleed):last-child) {
    margin-bottom: 0;
  }

  .case-body > :global(p:has(> img)),
  .case-body > :global(.image-slot),
  .case-body > :global(.case-wide) {
    grid-column: wide;
    margin-block: var(--space-7);
  }

  .case-body :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  /* Pull quote in the project's accent color. Set at h2 size so bright accents still meet
     WCAG AA for large text on white. */
  .case-body > :global(blockquote) {
    --quote-color: var(--case-accent-2, var(--color-text));
    margin-block: var(--space-7);
    padding-left: var(--space-5);
    border-left: var(--border-width) solid var(--quote-color);
    font-family: var(--case-font, var(--font-sans));
    font-size: var(--text-h2);
    font-weight: var(--weight-medium);
    line-height: var(--leading-heading);
    color: var(--quote-color);
  }

  /* A second paragraph in a pull quote is supporting text, set small like a caption */
  .case-body > :global(blockquote p + p),
  .case-body > :global(blockquote cite) {
    display: block;
    margin-top: var(--space-4);
    font-size: var(--text-small);
    font-style: normal;
    font-weight: var(--weight-regular);
    color: var(--color-text-secondary);
  }

  /* "Collection 01" label sits tight above its section heading, with room above it */
  .case-body > :global(.collection-label) {
    margin-top: var(--space-9);
    color: var(--case-heading-1, var(--color-text));
  }

  .case-body > :global(.collection-label + *) {
    margin-top: var(--space-2);
  }

  /* A short statement section between two dark bands (label, title and a paragraph),
     with equal space above and below so it sits centered between them */
  .case-body > :global(.case-centered) {
    padding-block: var(--space-6);
  }

  .case-body > :global(.case-centered) > :global(.eyebrow) {
    color: var(--case-heading-1, var(--color-text));
  }

  .case-body > :global(.case-centered) > :global(* + *) {
    margin-top: var(--space-3);
  }

  .case-body > :global(.case-centered) > :global(p:last-child) {
    margin-top: var(--space-4);
    color: var(--color-text-secondary);
  }

  @media (min-width: 48rem) {
    .case-body > :global(.case-centered) > :global(p:last-child) {
      font-size: var(--text-h3);
    }
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .gallery-title {
    margin-bottom: var(--space-6);
  }

  .next {
    padding-top: var(--space-8);
  }

  .next__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-6);
    border-top: var(--border);
    text-decoration: none;
  }

  .next__title {
    font-size: var(--text-h1);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
    color: var(--color-text);
  }

  /* One row of details: four columns, or five when a project adds a Type */
  @media (min-width: 48rem) {
    .meta-row {
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    }
  }
</style>
