---
import BaseLayout from '../layouts/BaseLayout.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import ImageSlot from '../components/ImageSlot.astro';
import { site } from '../site.config';
import headshot from '../assets/headshot.jpg';

// The resume buttons appear once public/resume.pdf exists.
const hasResume = existsSync(join(process.cwd(), 'public', site.resumePath));

// Content below comes from the resume. Update both together.
const education = [
  {
    title: 'BFA in Interaction (UI/UX) Design',
    meta: 'University of Kansas · Expected Spring 2027',
    note: 'GPA 3.97 · KU Excellence Scholarship',
  },
];

const awards = [
  {
    title: 'Dick Sloan Scholarship for Best Sophomore Portfolio',
    meta: 'National Student Show & Conference · 2025',
  },
];

const experience = [
  {
    title: 'Graphic Design Intern',
    meta: 'Latigo Creative · Jun – Jul 2026',
    details: [
      'Collaborated with multiple client brands to develop visual concepts aligned with their identities, audiences and project goals.',
      'Designed packaging and physical product graphics, translating creative direction into cohesive brand experiences.',
      'Took concepts from initial ideation through revisions, incorporating feedback and working with designers toward final production.',
    ],
  },
  {
    title: 'Apparel Product Design Intern',
    meta: 'The Wellness Society · Mar 2025 – Mar 2026',
    details: [
      'Led end-to-end product development and sourcing with overseas manufacturers, taking seasonal merchandise from concept through production while balancing quality, cost and standards.',
      'Partnered with company executives to ideate and refine product concepts, translating brand strategy into creative direction across seasonal collections.',
      'Built technical design files, product specifications and production-ready assets in Illustrator and Photoshop.',
      'Kept projects aligned in a fast-paced environment, communicating across leadership, design and production teams.',
    ],
  },
];

const involvement = [
  { title: 'KU Wellness Society', meta: 'Executive Board, Design & Photography · 2025 – present' },
  { title: 'KU Prototype Design', meta: 'Member · 2023 – present' },
  { title: 'Delta Gamma, Beta Kappa Chapter', meta: 'Member · 2023 – present' },
];

// Blocks in the three-column section
const infoBlocks = [
  { id: 'education', heading: 'Education', entries: education },
  { id: 'awards', heading: 'Awards', entries: awards },
  { id: 'involvement', heading: 'Involvement', entries: involvement },
];
---

<BaseLayout
  title="About"
  description="Victoria Neeser is an interaction (UI/UX) designer studying at the University of Kansas."
>
  <section class="container page-head">
    <h1>About</h1>
  </section>

  <section class="container bio" aria-label="Bio">
    <ImageSlot
      label="Portrait (about page)"
      src={headshot}
      alt={`Portrait of ${site.name}`}
      ratio="portrait"
      sizes="(min-width: 48rem) 33vw, 100vw"
      eager
    />
    <div class="prose">
      <p>
        I'm an interaction designer studying UI/UX at the University of Kansas, graduating in Spring 2027.
      </p>
      <p>
        I design interfaces and experiences across screens, products and brands, from user research and
        wireframes through to polished UI and working prototypes.
      </p>
      <p>
        My internships have spanned brand and packaging design at Latigo Creative and product development
        at The Wellness Society, where I took seasonal collections from concept to production alongside
        executives and overseas manufacturers.
      </p>
      <p class="meta">Based in St. Louis, MO</p>
      {
        hasResume && (
          <div class="resume-links">
            <a href={site.resumePath} class="button">View resume (PDF)</a>
            <a href={site.resumePath} class="button button--outline" download>
              Download
            </a>
          </div>
        )
      }
    </div>
  </section>

  <section class="section container about-section" aria-labelledby="experience-title">
    <h2 id="experience-title" class="eyebrow section-title">Experience</h2>
    <ul class="grid grid--2 entries" role="list">
      {
        experience.map(({ title, meta, details }) => (
          <li class="entry">
            <h3>{title}</h3>
            <p class="meta">{meta}</p>
            <ul class="entry__details">
              {details.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container about-section" aria-label="Education, awards and involvement">
    <div class="grid grid--3">
      {
        infoBlocks.map(({ id, heading, entries }) => (
          <div>
            <h2 id={`${id}-title`} class="eyebrow section-title">
              {heading}
            </h2>
            <ul class="entries entries--stack" role="list">
              {entries.map((e) => (
                <li class="entry">
                  <h3>{e.title}</h3>
                  <p class="meta">{e.meta}</p>
                  {'note' in e && <p class="meta">{e.note}</p>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .bio {
    display: grid;
    gap: var(--grid-gap);
    align-items: start;
  }

  .resume-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .about-section {
    padding-block: var(--space-8);
  }

  .section-title {
    margin-bottom: var(--space-5);
  }

  .entries {
    padding: 0;
    list-style: none;
  }

  .entries--stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .entry h3 {
    font-size: var(--text-body);
    line-height: var(--leading-heading);
    letter-spacing: normal;
  }

  .entry .meta {
    margin-top: var(--space-1);
  }

  .entry__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding-left: var(--space-5);
    list-style: disc;
  }

  @media (min-width: 48rem) {
    .bio {
      grid-template-columns: 1fr 2fr;
    }
  }
</style>
