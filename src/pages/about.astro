---
import BaseLayout from '../layouts/BaseLayout.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import ImageSlot from '../components/ImageSlot.astro';
import { site } from '../site.config';
import headshot from '../assets/headshot.jpg';

// The resume buttons appear once public/resume.pdf exists.
const hasResume = existsSync(join(process.cwd(), 'public', site.resumePath));

// Content below comes from the resume. Update both together.
const education = [
  {
    title: 'BFA in Interaction (UI/UX) Design',
    org: 'University of Kansas',
    dates: 'Expected Spring 2027',
    details: ['GPA 3.97'],
  },
];

const awards: { title: string; org?: string; dates: string }[] = [
  {
    title: 'Dick Sloan Scholarship for Best Sophomore Portfolio',
    org: 'National Student Show & Conference',
    dates: '2025',
  },
  { title: 'KU Excellence Scholarship', org: 'University of Kansas', dates: '2023 – present' },
  { title: "Dean's List", org: 'University of Kansas', dates: '2023 – present' },
  { title: 'American Hellenic Educational Progressive Association Scholarship', dates: '2023' },
];

const experience = [
  {
    title: 'Graphic Design Intern',
    org: 'Latigo Creative',
    dates: 'Jun – Jul 2026',
    details: [
      'Collaborated with multiple client brands to develop visual concepts aligned with their identities, audiences and project goals.',
      'Designed packaging and physical product graphics, translating creative direction into cohesive brand experiences.',
      'Took concepts from initial ideation through revisions, incorporating feedback and working with designers toward final production.',
    ],
  },
  {
    title: 'Apparel Product Design Intern',
    org: 'The Wellness Society',
    dates: 'Mar 2025 – Mar 2026',
    details: [
      'Led end-to-end product development and sourcing with overseas manufacturers, taking seasonal merchandise from concept through production while balancing quality, cost and standards.',
      'Partnered with company executives to ideate and refine product concepts, translating brand strategy into creative direction across seasonal collections.',
      'Built technical design files, product specifications and production-ready assets in Illustrator and Photoshop.',
      'Kept projects aligned in a fast-paced environment, communicating across leadership, design and production teams.',
    ],
  },
];

const involvement = [
  { title: 'Executive Board Member, Design & Photography', org: 'KU Wellness Society', dates: 'Mar 2025 – present' },
  { title: 'Member', org: 'KU Prototype Design', dates: 'Aug 2023 – present' },
  { title: 'Member', org: 'Delta Gamma Sorority, Beta Kappa Chapter', dates: 'Aug 2023 – present' },
];
---

<BaseLayout
  title="About"
  description="Victoria Neeser is an interaction (UI/UX) designer studying at the University of Kansas."
>
  <section class="container page-head">
    <h1>About</h1>
  </section>

  <section class="container bio" aria-label="Bio">
    <ImageSlot
      label="Portrait (about page)"
      src={headshot}
      alt={`Portrait of ${site.name}`}
      ratio="portrait"
      sizes="(min-width: 48rem) 33vw, 100vw"
      eager
    />
    <div class="prose">
      <p>
        With a background spanning graphic design, UI/UX, branding, and entrepreneurship, I approach each
        project from both a visual and user-centered perspective. I love turning complex ideas into
        experiences that feel simple, intuitive, and intentional.
      </p>
      <p>
        Outside of school, I’ve built and run my own creative business, worked with clients across different
        industries, and collaborated with teams on everything from digital products to physical products and
        brand experiences.
      </p>
      <p class="meta">Based in St. Louis, MO</p>
      {
        hasResume && (
          <div class="resume-links">
            <a href={site.resumePath} class="button">View resume (PDF)</a>
            <a href={site.resumePath} class="button button--outline" download>
              Download
            </a>
          </div>
        )
      }
    </div>
  </section>

  <section class="section container row" aria-labelledby="education-title">
    <h2 id="education-title" class="eyebrow">Education</h2>
    <ol class="timeline" role="list">
      {
        education.map(({ title, org, dates, details }) => (
          <li class="timeline__item">
            <p class="meta">{dates}</p>
            <div>
              <h3>{title}</h3>
              <p>{org}</p>
              <ul class="timeline__details meta">
                {details.map((d) => <li>{d}</li>)}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container row" aria-labelledby="awards-title">
    <h2 id="awards-title" class="eyebrow">Awards</h2>
    <ol class="timeline" role="list">
      {
        awards.map(({ title, org, dates }) => (
          <li class="timeline__item">
            <p class="meta">{dates}</p>
            <div>
              <h3>{title}</h3>
              {org && <p>{org}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container row" aria-labelledby="experience-title">
    <h2 id="experience-title" class="eyebrow">Experience</h2>
    <ol class="timeline" role="list">
      {
        experience.map(({ title, org, dates, details }) => (
          <li class="timeline__item">
            <p class="meta">{dates}</p>
            <div>
              <h3>{title}</h3>
              <p>{org}</p>
              <ul class="timeline__details timeline__details--bullets">
                {details.map((d) => <li>{d}</li>)}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container row" aria-labelledby="involvement-title">
    <h2 id="involvement-title" class="eyebrow">Involvement</h2>
    <ol class="timeline" role="list">
      {
        involvement.map(({ title, org, dates }) => (
          <li class="timeline__item">
            <p class="meta">{dates}</p>
            <div>
              <h3>{org}</h3>
              <p>{title}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

</BaseLayout>

<style>
  .bio {
    display: grid;
    gap: var(--grid-gap);
    align-items: center;
  }

  .resume-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  /* Section label on the left, content on the right (desktop) */
  .row {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  .timeline {
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: var(--border);
  }

  .timeline__item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .timeline__item p:not(.meta) {
    color: var(--color-text-secondary);
  }

  .timeline__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .timeline__details--bullets {
    padding-left: var(--space-5);
    list-style: disc;
  }

  @media (min-width: 48rem) {
    .bio {
      grid-template-columns: 1fr 2fr;
    }

    /* Narrower label and date columns leave more room for the content */
    .row {
      grid-template-columns: 1fr 6fr;
      gap: var(--grid-gap);
    }

    .timeline__item {
      grid-template-columns: 1fr 4fr;
      gap: var(--grid-gap);
    }
  }
</style>
