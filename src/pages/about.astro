---
import BaseLayout from '../layouts/BaseLayout.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import ImageSlot from '../components/ImageSlot.astro';
import { site } from '../site.config';
import headshot from '../assets/headshot.jpg';

// The resume buttons appear once public/resume.pdf exists.
const hasResume = existsSync(join(process.cwd(), 'public', site.resumePath));

// Content below comes from the resume. Update both together.
const education = [
  {
    title: 'BFA in Interaction (UI/UX) Design',
    meta: 'University of Kansas · Expected Spring 2027',
    note: 'GPA 3.97 · KU Excellence Scholarship',
  },
];

const awards = [
  {
    title: 'Dick Sloan Scholarship for Best Sophomore Portfolio',
    meta: 'National Student Show & Conference · 2025',
  },
];

// Short summaries; the full bullets are in the resume PDF.
const experience = [
  {
    title: 'Graphic Design Intern',
    meta: 'Latigo Creative · Jun – Jul 2026',
    note: 'Designed packaging and product graphics for multiple client brands, from first concepts through revisions to production.',
  },
  {
    title: 'Apparel Product Design Intern',
    meta: 'The Wellness Society · Mar 2025 – Mar 2026',
    note: 'Led seasonal merchandise from concept to production, partnering with executives on creative direction and with overseas manufacturers on sourcing.',
  },
];

const involvement = [
  { title: 'KU Wellness Society', meta: 'Executive Board, Design & Photography · 2025 – present' },
  { title: 'KU Prototype Design', meta: 'Member · 2023 – present' },
  { title: 'Delta Gamma, Beta Kappa Chapter', meta: 'Member · 2023 – present' },
];

const skills = [
  {
    group: 'UI/UX & product design',
    items: [
      'UI Design',
      'Interaction Design',
      'User Research',
      'Information Architecture',
      'User Flows',
      'Wireframing',
      'Prototyping',
      'Usability Testing',
      'Design Systems',
      'Responsive Design',
    ],
  },
  {
    group: 'Foundations',
    items: ['Adaptability', 'Time Management', 'Organization', 'Collaboration', 'Communication'],
  },
];

const tools = [
  {
    group: 'Design',
    items: ['Figma', 'Illustrator', 'Photoshop', 'InDesign', 'Procreate', 'Rive', 'TouchDesigner'],
  },
  {
    group: 'Code & web',
    items: ['GitHub', 'Visual Studio Code', 'Framer', 'Shopify', 'Squarespace', 'Wix'],
  },
  {
    group: 'AI',
    items: ['Claude', 'Claude Code', 'ChatGPT', 'Figma Make', 'Google Stitch', 'Google AI Studio'],
  },
];

// Right-hand column blocks
const sideBlocks = [
  { id: 'education', heading: 'Education', entries: education },
  { id: 'awards', heading: 'Awards', entries: awards },
  { id: 'involvement', heading: 'Involvement', entries: involvement },
];
---

<BaseLayout
  title="About"
  description="Victoria Neeser is an interaction (UI/UX) designer studying at the University of Kansas."
>
  <section class="container page-head">
    <h1>About</h1>
  </section>

  <section class="container bio" aria-label="Bio">
    <ImageSlot
      label="Portrait (about page)"
      src={headshot}
      alt={`Portrait of ${site.name}`}
      ratio="portrait"
      sizes="(min-width: 48rem) 33vw, 100vw"
      eager
    />
    <div class="prose">
      <p>
        I'm an interaction designer studying UI/UX at the University of Kansas, graduating in Spring 2027.
      </p>
      <p>
        I design interfaces and experiences across screens, products and brands, from user research and
        wireframes through to polished UI and working prototypes.
      </p>
      <p>
        My internships have spanned brand and packaging design at Latigo Creative and product development
        at The Wellness Society, where I took seasonal collections from concept to production alongside
        executives and overseas manufacturers.
      </p>
      <p class="meta">Based in St. Louis, MO</p>
      {
        hasResume && (
          <div class="resume-links">
            <a href={site.resumePath} class="button">View resume (PDF)</a>
            <a href={site.resumePath} class="button button--outline" download>
              Download
            </a>
          </div>
        )
      }
    </div>
  </section>

  <section class="section container columns">
    <div class="block">
      <h2 id="experience-title" class="eyebrow">Experience</h2>
      <ul class="entries" role="list">
        {
          experience.map(({ title, meta, note }) => (
            <li class="entry">
              <h3>{title}</h3>
              <p class="meta">{meta}</p>
              <p class="entry__note">{note}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="side">
      {
        sideBlocks.map(({ id, heading, entries }) => (
          <div class="block">
            <h2 id={`${id}-title`} class="eyebrow">
              {heading}
            </h2>
            <ul class="entries" role="list">
              {entries.map((e) => (
                <li class="entry">
                  <h3>{e.title}</h3>
                  <p class="meta">{e.meta}</p>
                  {'note' in e && <p class="meta">{e.note}</p>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section container columns columns--even">
    {
      [
        { id: 'skills', heading: 'Skills', groups: skills },
        { id: 'tools', heading: 'Tools', groups: tools },
      ].map(({ id, heading, groups }) => (
        <div class="block">
          <h2 id={`${id}-title`} class="eyebrow">
            {heading}
          </h2>
          {groups.map(({ group, items }) => (
            <div class="group">
              <h3 class="group__title">{group}</h3>
              <ul class="tag-list">
                {items.map((item) => (
                  <li class="tag">{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .bio {
    display: grid;
    gap: var(--grid-gap);
    align-items: start;
  }

  .resume-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .columns {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-8);
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .block > .eyebrow {
    margin-bottom: var(--space-5);
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .entry h3 {
    font-size: var(--text-body);
    line-height: var(--leading-heading);
    letter-spacing: normal;
  }

  .entry .meta {
    margin-top: var(--space-1);
  }

  .entry__note {
    margin-top: var(--space-2);
  }

  .group + .group {
    margin-top: var(--space-5);
  }

  .group__title {
    margin-bottom: var(--space-3);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: normal;
    color: var(--color-text-secondary);
  }

  @media (min-width: 48rem) {
    .bio {
      grid-template-columns: 1fr 2fr;
    }

    .columns {
      grid-template-columns: 3fr 2fr;
      gap: var(--space-9);
    }

    .columns--even {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
