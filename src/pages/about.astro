---
import BaseLayout from '../layouts/BaseLayout.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import ImageSlot from '../components/ImageSlot.astro';
import { site } from '../site.config';
import headshot from '../assets/headshot.jpg';

// The resume buttons appear once public/resume.pdf exists.
const hasResume = existsSync(join(process.cwd(), 'public', site.resumePath));

// Content below comes from the resume. Update both together.
const education = [
  {
    title: 'BFA in Interaction (UI/UX) Design',
    org: 'University of Kansas',
    dates: 'Expected Spring 2027',
    details: ['GPA 3.98'],
  },
];

const awards: { title: string; org?: string; dates: string }[] = [
  {
    title: 'Dick Sloan Scholarship for Best Sophomore Portfolio',
    org: 'National Student Show & Conference',
    dates: '2025',
  },
  { title: 'KU Excellence Scholarship', org: 'University of Kansas', dates: '2023 – present' },
  { title: "Dean's List", org: 'University of Kansas', dates: '2023 – present' },
  { title: 'American Hellenic Educational Progressive Association Scholarship', dates: '2023' },
];

const experience = [
  {
    title: 'Graphic Design Intern',
    org: 'Latigo Creative',
    dates: 'Jun – Jul 2026',
    details: [
      'Collaborated with diverse client brands to research, develop and refine creative concepts, translating brand identities, audiences and project objectives into cohesive visual designs and creative solutions.',
      'Designed packaging, product graphics and branded assets, refining creative concepts through collaboration and feedback to deliver cohesive, high-quality, production-ready designs.',
    ],
  },
  {
    title: 'Apparel Product Design Intern',
    org: 'The Wellness Society',
    dates: 'Mar 2025 – Mar 2026',
    details: [
      'Managed end-to-end product sourcing and production, collaborating with overseas manufacturers to balance quality, cost and brand standards.',
      'Partnered directly with CEOs to develop product concepts and lead creative direction for seasonal merchandise aligned with strategic brand goals.',
      'Created production-ready technical files and product specifications in Adobe Illustrator and Photoshop while optimizing inventory workflows and production timelines.',
    ],
  },
  {
    title: 'Freelance UI/UX & Graphic Designer',
    org: 'Victoria Anne Studios',
    dates: 'Aug 2022 – present',
    details: [
      'Manage end-to-end client projects across UI/UX design, branding and website development, creating user-centered digital experiences and cohesive visual identities.',
      'Design and develop websites using Figma, Squarespace, Wix, Framer and Shopify, translating client goals into consistent visual solutions across digital and print touchpoints.',
      'Founded and currently manage an Etsy business, overseeing product design, e-commerce listings, order fulfillment and customer experience.',
    ],
  },
];

const involvement = [
  { title: 'Executive Board Member, Design & Photography', org: 'KU Wellness Society', dates: 'Mar 2025 – present' },
  { title: 'Member', org: 'KU Prototype Design', dates: 'Aug 2023 – present' },
  { title: 'Member', org: 'Delta Gamma Sorority, Beta Kappa Chapter', dates: 'Aug 2023 – present' },
];
---

<BaseLayout
  title="About"
  description="Victoria Neeser is an interaction (UI/UX) designer studying at the University of Kansas."
>
  <section class="container page-head">
    <h1>About</h1>
  </section>

  <section class="container bio" aria-label="Bio">
    <ImageSlot
      label="Portrait (about page)"
      src={headshot}
      alt={`Portrait of ${site.name}`}
      ratio="portrait"
      sizes="(min-width: 48rem) 33vw, 100vw"
      eager
    />
    <div class="prose">
      <p>
        With a background spanning graphic design, UI/UX, branding, and entrepreneurship, I approach each
        project from both a visual and user-centered perspective. I love turning complex ideas into
        experiences that feel simple, intuitive, and intentional.
      </p>
      <p>
        Outside of school, I’ve built and run my own creative business, worked with clients across different
        industries, and collaborated with teams on everything from digital products to physical products and
        brand experiences.
      </p>
      <p class="meta">Based in St. Louis, MO</p>
      {
        hasResume && (
          <div class="resume-links">
            <a href={site.resumePath} class="button">View resume (PDF)</a>
            <a href={site.resumePath} class="button button--outline" download>
              Download
            </a>
          </div>
        )
      }
    </div>
  </section>

  <section class="section container row" aria-labelledby="education-title">
    <h2 id="education-title" class="eyebrow">Education</h2>
    <ol class="timeline" role="list">
      {
        education.map(({ title, org, dates, details }) => (
          <li class="timeline__item">
            <p class="meta">{dates}</p>
            <div>
              <h3>{title}</h3>
              <p>{org}</p>
              <ul class="timeline__details meta">
                {details.map((d) => <li>{d}</li>)}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container row" aria-labelledby="awards-title">
    <h2 id="awards-title" class="eyebrow">Awards</h2>
    <ol class="timeline" role="list">
      {
        awards.map(({ title, org, dates }) => (
          <li class="timeline__item">
            <p class="meta">{dates}</p>
            <div>
              <h3>{title}</h3>
              {org && <p>{org}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container row" aria-labelledby="experience-title">
    <h2 id="experience-title" class="eyebrow">Experience</h2>
    <ol class="timeline" role="list">
      {
        experience.map(({ title, org, dates, details }) => (
          <li class="timeline__item">
            <p class="meta">{dates}</p>
            <div>
              <h3>{title}</h3>
              <p>{org}</p>
              <ul class="timeline__details timeline__details--bullets">
                {details.map((d) => <li>{d}</li>)}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container row" aria-labelledby="involvement-title">
    <h2 id="involvement-title" class="eyebrow">Involvement</h2>
    <ol class="timeline" role="list">
      {
        involvement.map(({ title, org, dates }) => (
          <li class="timeline__item">
            <p class="meta">{dates}</p>
            <div>
              <h3>{org}</h3>
              <p>{title}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

</BaseLayout>

<style>
  .bio {
    display: grid;
    gap: var(--grid-gap);
    align-items: center;
  }

  .resume-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  /* Section label on the left, content on the right (desktop) */
  .row {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  .timeline {
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: var(--border);
  }

  .timeline__item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .timeline__item p:not(.meta) {
    color: var(--color-text-secondary);
  }

  .timeline__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .timeline__details--bullets {
    padding-left: var(--space-5);
    list-style: disc;
  }

  @media (min-width: 48rem) {
    .bio {
      grid-template-columns: 1fr 2fr;
    }

    /* Narrower label and date columns leave more room for the content */
    .row {
      grid-template-columns: 1fr 6fr;
      gap: var(--grid-gap);
    }

    .timeline__item {
      grid-template-columns: 1fr 4fr;
      gap: var(--grid-gap);
    }
  }
</style>
