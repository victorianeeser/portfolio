---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { site } from '../site.config';
import { getProjects } from '../lib/projects';
import headshot from '../assets/headshot.jpg';

const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 6);
---

<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <h1 id="hero-title" class="display">{site.name}</h1>
    <p class="hero__statement lead">{site.positioning}</p>
  </section>

  <section class="section container" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title" class="eyebrow">Selected work</h2>
      <a href="/work/" class="link-arrow">All projects</a>
    </div>
    <div class="grid grid--2">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section container" aria-labelledby="about-title">
    <div class="about-teaser">
      <ImageSlot
        label="Portrait (home teaser)"
        src={headshot}
        alt={`Portrait of ${site.name}`}
        ratio="portrait"
        focus="50% 25%"
        sizes="(min-width: 48rem) 33vw, 100vw"
      />
      <div class="stack">
        <h2 id="about-title" class="eyebrow">About me</h2>
        <p class="about-teaser__text">
          [Placeholder: 2–3 sentence intro. Who you are, what you design and build, and
          what you're looking for next.]
        </p>
        <a href="/about/" class="link-arrow">More about me</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-9);
  }

  .hero__statement {
    max-width: var(--container-narrow);
    margin-top: var(--space-5);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .about-teaser {
    display: grid;
    gap: var(--grid-gap);
    align-items: center;
  }

  .about-teaser__text {
    font-size: var(--text-h3);
    color: var(--color-text);
  }

  @media (min-width: 48rem) {
    .about-teaser {
      grid-template-columns: 1fr 2fr;
    }
  }
</style>
